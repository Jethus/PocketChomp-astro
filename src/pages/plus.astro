---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogPath } from "../lib/og-cards";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionShell from "../components/ui/SectionShell.astro";
import AppCta from "../components/ui/AppCta.astro";
import ScreenRail from "../components/ScreenRail.astro";
import shotDynamicTdee from "../assets/screens/screen-dynamic-tdee.webp";
import shotWeeklyBudget from "../assets/screens/screen-weekly-budget.webp";
import shotBudgetEditor from "../assets/screens/screen-weekly-budget-editor.webp";
import shotInsights90d from "../assets/screens/screen-insights-90d.webp";

// Plus screens live here, never in the home page's row.
const plusScreens = [
  {
    image: shotDynamicTdee,
    alt: "PocketChomp plan showing the next check-in in 5 days on Monday, November 2, a 2,323 kcal expenditure, a 374 kcal deficit, and this week's 6,660 of 13,643 calories",
  },
  {
    image: shotWeeklyBudget,
    alt: "PocketChomp plan with a weekly calorie budget of 1,932 a day and 2,049 on Friday, 6,660 of 13,643 used, a fibre goal of at least 12 g a day met on 13 of 16 days, and body weight of 217.6 lb",
  },
  {
    image: shotBudgetEditor,
    alt: "PocketChomp weekly budget editor with Friday given 100 extra calories, the other days at 1,932, an average of 1,949 a day, and a Reset to even button",
  },
  {
    image: shotInsights90d,
    alt: "PocketChomp Insights over 90 days with a weekly calorie trend from Jul 31 to Oct 28 against a 1,949 kcal target, the most logged foods, and the weekly rhythm",
  },
];

const entry = await getEntry("landingFreePremium", "free-premium");

if (!entry) {
  throw new Error("Could not find PocketChomp free-premium content");
}

const {
  headline,
  description,
  funding,
  freeTitle,
  freeNote,
  premiumTitle,
  comparison,
} = entry.data;

// The matrix rows sorted by what a reader is deciding: what both tiers get,
// what only Plus has, and where Plus lifts a free limit.
const shared = comparison.filter((r) => r.free === true || (typeof r.free === "string" && r.free === r.plus));
const plusOnly = comparison.filter((r) => r.free === false);
const raised = comparison.filter((r) => typeof r.free === "string" && r.free !== r.plus);

const TITLE = "PocketChomp+ — what's free and what's paid";
const META =
  "Every PocketChomp feature, free versus PocketChomp+. Barcode scanning, label scanning, micronutrients and offline logging are free forever. No ads on either tier.";
---

<BaseLayout title={TITLE} description={META} image={ogPath("plus")}>
  <Header />
  <main id="main">
    <SectionShell>
      <div class="plus-head">
        <h1 class="fs-xl mt-4 leading-[1.05] text-foreground">{headline}</h1>
        <p class="mt-5 text-lg leading-relaxed text-foreground-soft">
          {description}
        </p>
      </div>
    </SectionShell>

    <SectionShell class="!pt-0">
      <div class="tiers">
        <section class="tier">
          <h2 class="tier__name">{freeTitle}</h2>
          <p class="tier__note">{freeNote}</p>
          <ul class="tier__list" role="list">
            {shared.map((row) => (
              <li>
                {row.feature}
                {typeof row.free === "string" && <span class="tier__detail">{row.free}</span>}
              </li>
            ))}
          </ul>
        </section>

        <section class="tier tier--plus">
          <h2 class="tier__name">{premiumTitle}</h2>
          <p class="tier__note">Everything in {freeTitle}, plus:</p>
          <ul class="tier__list" role="list">
            {plusOnly.map((row) => <li>{row.feature}</li>)}
          </ul>
          <h3 class="tier__sub">Higher limits</h3>
          <ul class="tier__list" role="list">
            {raised.map((row) => (
              <li>
                {row.feature}: {row.plus.toString().toLowerCase()}
                <span class="tier__detail">{freeTitle}: {row.free.toString().toLowerCase()}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </SectionShell>

    <ScreenRail id="plus-screens" eyebrow="Inside PocketChomp+" screens={plusScreens} />

    <SectionShell class="!pt-0">
      <p class="funding-note">{funding}</p>

      <div class="cta-panel mt-14">
        <h2 class="fs-m text-foreground">Try it before you pay for it.</h2>
        <p class="mt-2 max-w-xl text-muted-foreground">
          The free tier is the whole logging loop, not a trial. Install the open beta and
          decide about Plus later.
        </p>
        <div class="mt-5 max-w-xl">
          <AppCta placement="plus" />
        </div>
      </div>
    </SectionShell>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* The page is one centred column: the copy and the table share a measure
     and a centre line, rather than the table hugging the left edge of a
     much wider shell. */
  .plus-head,
  .funding-note,
  .cta-panel {
    max-width: 46rem;
    margin-inline: auto;
  }

  /* Two cards, not a matrix: most features are in both tiers, so a table
     spent most of its rows on ticks in both columns. */
  .tiers {
    display: grid;
    gap: 1rem;
    max-width: 56rem;
    margin-inline: auto;
  }

  @media (min-width: 44rem) {
    .tiers {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .tier {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.75rem;
  }

  .tier--plus {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    background: color-mix(in oklab, var(--accent) 7%, var(--surface));
  }

  .tier__name {
    font-size: 1.6rem;
    color: var(--foreground);
  }

  .tier--plus .tier__name {
    color: var(--accent-text);
  }

  .tier__note {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
  }

  .tier__sub {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: var(--foreground);
  }

  .tier__list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .tier__list li {
    position: relative;
    padding-left: 1.75rem;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .tier__list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 900;
    color: var(--primary-strong);
  }

  .tier--plus .tier__list li::before {
    color: var(--accent-text);
  }

  .tier__detail {
    display: block;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--muted-foreground);
  }

  /* Stated plainly rather than as a badge: the business model IS the proof. */
  .funding-note {
    padding-left: 1rem;
    border-left: 2px solid color-mix(in oklab, var(--primary) 45%, transparent);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--foreground-soft);
  }

  .cta-panel {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.75rem;
    box-shadow: var(--shadow-elevated);
  }

</style>
