---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogPath } from "../lib/og-cards";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionShell from "../components/ui/SectionShell.astro";
import AppCta from "../components/ui/AppCta.astro";
import ScreenRail from "../components/ScreenRail.astro";
import shotDynamicTdee from "../assets/screens/screen-dynamic-tdee.webp";
import shotWeeklyBudget from "../assets/screens/screen-weekly-budget.webp";
import shotBudgetEditor from "../assets/screens/screen-weekly-budget-editor.webp";
import shotInsights90d from "../assets/screens/screen-insights-90d.webp";
import shotPhotoCamera from "../assets/screens/screen-photo-camera.webp";
import shotEnergyBalance from "../assets/screens/screen-insights-energy.webp";
import shotOftenUnder from "../assets/screens/screen-insights-under.webp";

// Plus screens live here, never in the home page's row.
const plusScreens = [
  {
    image: shotPhotoCamera,
    alt: "PocketChomp Add Food on the Photo tab, the camera pointed at a quiche with the prompt Point at your meal and tap to identify, and a Choose from album button",
  },
  {
    image: shotDynamicTdee,
    alt: "PocketChomp plan showing the next check-in in 5 days on Monday, November 2, a 2,323 kcal expenditure, a 374 kcal deficit, and this week's 6,660 of 13,643 calories",
  },
  {
    image: shotWeeklyBudget,
    alt: "PocketChomp plan with a weekly calorie budget of 1,932 a day and 2,049 on Friday, 6,660 of 13,643 used, a fibre goal of at least 12 g a day met on 13 of 16 days, and body weight of 217.6 lb",
  },
  {
    image: shotBudgetEditor,
    alt: "PocketChomp weekly budget editor with Friday given 100 extra calories, the other days at 1,932, an average of 1,949 a day, and a Reset to even button",
  },
  {
    image: shotInsights90d,
    alt: "PocketChomp Insights over 90 days with a weekly calorie trend from Jul 31 to Oct 28 against a 1,949 kcal target, the most logged foods, and the weekly rhythm",
  },
  {
    image: shotEnergyBalance,
    alt: "PocketChomp Insights with the weekly rhythm by weekday, an energy balance of minus 26 kcal a day from an intake of 2,297 against a TDEE of 2,323, and a weight trend at 217.8 lb",
  },
  {
    image: shotOftenUnder,
    alt: "PocketChomp Insights with carbs, fat and fibre averages against their targets, an Often under target card showing potassium under on 8 of 9 days, and a calorie trend from Sep 29 to Oct 28",
  },
];

const entry = await getEntry("landingFreePremium", "free-premium");

if (!entry) {
  throw new Error("Could not find PocketChomp free-premium content");
}

const {
  headline,
  description,
  funding,
  freeTitle,
  freeNote,
  premiumTitle,
  premiumNote,
  premiumPrice,
  comparison,
} = entry.data;

// The matrix rows sorted by what a reader is deciding: what both tiers get,
// what only Plus has, and where Plus lifts a free limit.
const shared = comparison.filter((r) => r.free === true || (typeof r.free === "string" && r.free === r.plus));
const plusOnly = comparison.filter((r) => r.free === false);
const raised = comparison.filter((r) => typeof r.free === "string" && r.free !== r.plus);

const TITLE = "PocketChomp+ — what's free and what's paid";
const META =
  "Free vs PocketChomp+, feature by feature. Barcode scanning, label scanning, micronutrients and offline logging are free forever. No ads on either tier.";
---

<BaseLayout title={TITLE} description={META} image={ogPath("plus")}>
  <Header />
  <main id="main">
    <SectionShell>
      <div class="plus-head">
        <h1 class="fs-xl mt-4 leading-[1.05] text-foreground">{headline}</h1>
        <p class="mt-5 text-lg leading-relaxed text-foreground-soft">
          {description}
        </p>
      </div>
    </SectionShell>

    <SectionShell class="!pt-0">
      <div class="compare">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="col-free">
                {freeTitle}
                <span class="col-sub">{freeNote}</span>
              </th>
              <th scope="col" class="col-plus">
                {premiumTitle}
                <span class="col-sub">{premiumPrice}</span>
              </th>
            </tr>
          </thead>
          {[
            { title: `In ${freeTitle} and ${premiumTitle}`, rows: shared },
            { title: `Only in ${premiumTitle}`, rows: plusOnly },
            { title: "Higher limits", rows: raised },
          ].map((group) => (
            <tbody>
              <tr class="group">
                <th scope="colgroup" colspan="3">{group.title}</th>
              </tr>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {[row.free, row.plus].map((cell, i) => (
                    <td class={i === 0 ? "col-free" : "col-plus"}>
                      {cell === true ? (
                        <><span class="tick" aria-hidden="true">✓</span><span class="sr-only">Included</span></>
                      ) : cell === false ? (
                        <><span class="dash" aria-hidden="true">–</span><span class="sr-only">Not included</span></>
                      ) : (
                        cell
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
        <p class="compare__price">{premiumTitle} is {premiumNote}</p>
      </div>
    </SectionShell>

    <ScreenRail id="plus-screens" eyebrow="Inside PocketChomp+" screens={plusScreens} />

    <SectionShell>
      <p class="funding-note">{funding}</p>

      <div class="cta-panel mt-14">
        <h2 class="fs-m text-foreground">Try it before you pay for it.</h2>
        <p class="mt-2 max-w-xl text-muted-foreground">
          The free tier is the whole logging loop, not a trial. Install the app and
          decide about Plus later.
        </p>
        <div class="mt-5 max-w-xl">
          <AppCta placement="plus" />
        </div>
      </div>
    </SectionShell>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* The page is one centred column: the copy and the table share a measure
     and a centre line, rather than the table hugging the left edge of a
     much wider shell. */
  .plus-head,
  .funding-note,
  .cta-panel {
    max-width: 46rem;
    margin-inline: auto;
  }

  /* One table, so the ticks running down both columns show that Plus is
     everything in Free and more. The Plus column is tinted top to bottom. */
  .compare {
    max-width: 46rem;
    margin-inline: auto;
  }

  .compare table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .compare th,
  .compare td {
    padding: 0.85rem 0.75rem;
    text-align: left;
    vertical-align: middle;
    line-height: 1.4;
  }

  .compare .col-free,
  .compare .col-plus {
    width: 8.5rem;
    text-align: center;
  }

  .compare .col-plus {
    background: color-mix(in oklab, var(--accent) 9%, transparent);
  }

  .compare thead th {
    padding-block: 1.1rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--foreground);
    vertical-align: bottom;
  }

  .compare thead .col-plus {
    color: var(--accent-text);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .col-sub {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .compare tbody tr + tr th,
  .compare tbody tr + tr td {
    border-top: 1px solid color-mix(in oklab, var(--foreground) 10%, transparent);
  }

  .compare tbody th {
    font-weight: 500;
    color: var(--foreground);
  }

  .compare .group th {
    padding-top: 2rem;
    padding-bottom: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    border-bottom: 1px solid color-mix(in oklab, var(--foreground) 22%, transparent);
  }

  .compare td {
    color: var(--muted-foreground);
  }

  .compare td.col-plus {
    font-weight: 600;
    color: var(--accent-text);
  }

  .tick {
    font-weight: 900;
    color: var(--primary-strong);
  }

  .col-plus .tick {
    color: var(--accent-text);
  }

  .dash {
    color: var(--muted-foreground);
  }

  .compare__price {
    margin-top: 1.25rem;
    text-align: center;
    color: var(--foreground-soft);
  }

  .compare td {
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .compare th,
    .compare td {
      padding-inline: 0.5rem;
      font-size: 0.95rem;
    }

    .compare .col-free,
    .compare .col-plus {
      width: 4.75rem;
    }

    .compare thead th {
      font-size: 0.95rem;
    }

    .compare thead .col-free .col-sub {
      display: none;
    }
  }

  /* Stated plainly rather than as a badge: the business model IS the proof. */
  .funding-note {
    padding-left: 1rem;
    border-left: 2px solid color-mix(in oklab, var(--primary) 45%, transparent);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--foreground-soft);
  }

  .cta-panel {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.75rem;
    box-shadow: var(--shadow-elevated);
  }

</style>
