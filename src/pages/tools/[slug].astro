---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionShell from "../../components/ui/SectionShell.astro";
import EyebrowPill from "../../components/ui/EyebrowPill.astro";
import SignupForm from "../../components/ui/SignupForm.astro";
import CalorieCalculator from "../../components/tools/CalorieCalculator.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tools");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  title,
  metaDescription,
  eyebrow,
  h1,
  intro,
  mode,
  faq,
  realityCheck,
  ctaHeadline,
  ctaNote,
  related,
} = entry.data;

const { Content } = await render(entry);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout title={title} description={metaDescription}>
  <Header />
  <main>
    <SectionShell innerClass="max-w-4xl space-y-10">
      <div>
        <EyebrowPill>{eyebrow}</EyebrowPill>
        <h1 class="fs-xl mt-4 leading-[1.02] text-foreground">{h1}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {intro}
        </p>
      </div>

      <CalorieCalculator mode={mode} />

      <div>
        <h2 class="fs-m text-foreground">After 14 days of tracking</h2>
        <p class="mt-2 max-w-2xl text-muted-foreground">
          A calculator gets you close; your real trend gets you exact. Compare
          your two-week result against this table:
        </p>
        <div class="mt-5 overflow-x-auto">
          <table class="reality-table">
            <thead>
              <tr><th>What you observe</th><th>What to change</th></tr>
            </thead>
            <tbody>
              {realityCheck.map((row) => (
                <tr>
                  <td>{row.condition}</td>
                  <td>{row.adjustment}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="cta-panel">
        <h2 class="fs-m text-foreground">{ctaHeadline}</h2>
        <p class="mt-2 max-w-xl text-muted-foreground">{ctaNote}</p>
        <div class="mt-5 max-w-xl">
          <SignupForm placeholder="you@email.com" buttonText="Get early access" />
        </div>
      </div>

      <article class="prose-body">
        <Content />
      </article>

      <div>
        <h2 class="fs-m text-foreground">Frequently asked questions</h2>
        <div class="faq-list mt-5">
          {faq.map((item) => (
            <details class="faq-item">
              <summary class="faq-item__q">
                <span>{item.q}</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="48" stroke-linecap="round">
                    <line x1="256" y1="112" x2="256" y2="400" />
                    <line x1="112" y1="256" x2="400" y2="256" />
                  </svg>
                </span>
              </summary>
              <p class="faq-item__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>

      <p class="related-link">
        <a href={related.href}>{related.label} →</a>
      </p>
    </SectionShell>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<style>
  .reality-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 34rem;
  }

  .reality-table th,
  .reality-table td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.45;
  }

  .reality-table th {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .reality-table td:first-child {
    color: var(--foreground);
  }

  .reality-table td:last-child {
    color: var(--muted-foreground);
  }

  /* Under 40rem the two-column table stacks into observation/adjustment
     pairs — no sideways scrolling with clipped text on phones */
  @media (max-width: 40rem) {
    .reality-table {
      min-width: 0;
    }

    .reality-table thead {
      display: none;
    }

    .reality-table tr {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }

    .reality-table td {
      display: block;
      padding: 0;
      border-bottom: 0;
    }

    .reality-table td:last-child {
      margin-top: 0.3rem;
    }
  }

  .cta-panel {
    border-radius: 1.6rem;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--primary) 6%, var(--surface));
    box-shadow: var(--shadow-elevated);
    padding: 2rem;
  }

  /* Markdown headings join the site's fluid scale (one step below section h2s)
     instead of a fixed size that collapses into body text */
  .prose-body :global(h2) {
    --fl: 1;
    font-size: var(--fluid-type);
    margin-top: 2.25rem;
  }

  .prose-body :global(p) {
    margin-top: 0.8rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    max-width: 65ch;
  }

  .faq-list {
    display: grid;
    gap: 0.9rem;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
  }

  .faq-item__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--foreground);
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 12%, var(--surface));
    color: var(--primary);
    transition: transform 0.2s ease;
  }

  .faq-item__icon svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__a {
    margin: 0;
    padding: 0 1.4rem 1.25rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    max-width: 65ch;
  }

  .related-link a {
    font-weight: 700;
    color: var(--primary);
  }

  .related-link a:hover {
    text-decoration: underline;
  }
</style>
