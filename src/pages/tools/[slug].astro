---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionShell from "../../components/ui/SectionShell.astro";
import SignupForm from "../../components/ui/SignupForm.astro";
import FaqList from "../../components/ui/FaqList.astro";
import CalorieCalculator from "../../components/tools/CalorieCalculator.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tools");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Every calculator links to every other one. Four pages targeting adjacent
// queries interlink cheaply, and it keeps a visitor who landed on the wrong
// one from bouncing back to the search results.
const allTools = await getCollection("tools");
const TOOL_ORDER = [
  "tdee-calculator",
  "calorie-deficit-calculator",
  "macro-calculator",
  "bmr-calculator",
];
const otherTools = allTools
  .filter((t) => t.id !== entry.id)
  .sort((a, b) => TOOL_ORDER.indexOf(a.id) - TOOL_ORDER.indexOf(b.id));
const {
  title,
  metaDescription,
  eyebrow,
  h1,
  intro,
  mode,
  faq,
  realityCheck,
  ctaHeadline,
  ctaNote,
  related,
} = entry.data;

const { Content } = await render(entry);

const canonical = new URL(`/tools/${entry.id}`, Astro.site ?? Astro.url).href;

// One @graph rather than three separate blocks so the nodes can reference each
// other: the calculator is the primary entity of the page, and the FAQ hangs
// off the same page node instead of floating free.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonical}#calculator`,
      name: h1,
      url: canonical,
      description: metaDescription,
      applicationCategory: "HealthApplication",
      operatingSystem: "Any",
      browserRequirements: "Requires JavaScript",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site ?? Astro.url).href,
        },
        { "@type": "ListItem", position: 2, name: h1, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={metaDescription}>
  <Header />
  <main>
    <SectionShell innerClass="max-w-4xl space-y-10">
      <div>
        <p class="font-heading text-[0.7rem] font-black uppercase tracking-[0.16em] text-muted-foreground">{eyebrow}</p>
        <h1 class="fs-xl mt-4 leading-[1.02] text-foreground">{h1}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {intro}
        </p>
      </div>

      <CalorieCalculator mode={mode} />

      <div>
        <h2 class="fs-m text-foreground">After 14 days of tracking</h2>
        <p class="mt-2 max-w-2xl text-muted-foreground">
          A calculator gets you close; your real trend gets you exact. Compare
          your two-week result against this table:
        </p>
        <div class="mt-5 overflow-x-auto">
          <table class="reality-table">
            <thead>
              <tr><th>What you observe</th><th>What to change</th></tr>
            </thead>
            <tbody>
              {realityCheck.map((row) => (
                <tr>
                  <td>{row.condition}</td>
                  <td>{row.adjustment}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="cta-panel">
        <h2 class="fs-m text-foreground">{ctaHeadline}</h2>
        <p class="mt-2 max-w-xl text-muted-foreground">{ctaNote}</p>
        <div class="mt-5 max-w-xl">
          <SignupForm placeholder="you@email.com" buttonText="Join the beta" placement="tool" />
        </div>
      </div>

      <article class="prose-body">
        <Content />
      </article>

      <div>
        <h2 class="fs-m text-foreground">Frequently asked questions</h2>
        <FaqList items={faq} class="mt-5" />
      </div>

      <p class="related-link">
        <a href={related.href}>{related.label} →</a>
      </p>

      <nav class="tool-links" aria-label="Other calculators">
        <h2 class="fs-s text-foreground">Other calculators</h2>
        <ul>
          {otherTools.map((t) => (
            <li>
              <a href={`/tools/${t.id}`}>
                <span class="tool-links__name">{t.data.h1}</span>
                <span class="tool-links__desc">{t.data.eyebrow}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </SectionShell>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .reality-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 34rem;
  }

  .reality-table th,
  .reality-table td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.45;
  }

  .reality-table th {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .reality-table td:first-child {
    color: var(--foreground);
  }

  .reality-table td:last-child {
    color: var(--muted-foreground);
  }

  /* Under 40rem the two-column table stacks into observation/adjustment
     pairs — no sideways scrolling with clipped text on phones */
  @media (max-width: 40rem) {
    .reality-table {
      min-width: 0;
    }

    .reality-table thead {
      display: none;
    }

    .reality-table tr {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }

    .reality-table td {
      display: block;
      padding: 0;
      border-bottom: 0;
    }

    .reality-table td:last-child {
      margin-top: 0.3rem;
    }
  }

  .cta-panel {
    border-radius: 1.6rem;
    border: 1px solid color-mix(in oklab, var(--primary) 30%, var(--border));
    background: color-mix(in oklab, var(--primary) 9%, var(--surface));
    box-shadow: var(--shadow-elevated);
    padding: 2.25rem 2rem;
    margin-block: 0.75rem;
  }

  /* Markdown headings join the site's fluid scale (one step below section h2s)
     instead of a fixed size that collapses into body text */
  .prose-body :global(h2) {
    --fl: 1;
    font-size: var(--fluid-type);
    margin-top: 2.25rem;
  }

  .prose-body :global(p) {
    margin-top: 0.8rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    max-width: 65ch;
  }

  .tool-links ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .tool-links ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tool-links a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 1.1rem;
    background: var(--surface);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .tool-links a:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .tool-links__name {
    font-weight: 700;
    color: var(--primary);
  }

  .tool-links__desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .related-link a {
    font-weight: 700;
    color: var(--primary);
  }

  .related-link a:hover {
    text-decoration: underline;
  }
</style>
