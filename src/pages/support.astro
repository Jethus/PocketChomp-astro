---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionShell from "../components/ui/SectionShell.astro";

const entry = await getEntry("landingSupport", "support");

if (!entry) {
  throw new Error("Could not find PocketChomp support content");
}

const { eyebrow, headline, intro, email, topics, stuckHeadline, stuckBody } = entry.data;

const TITLE = "Support";
const META =
  "Get help with PocketChomp: contact the developer, manage your PocketChomp+ subscription, export or delete your data.";

// `{email}` in the copy becomes a mailto link. Split once so the pieces can
// be rendered on one line: the HTML compressor drops a newline between text
// and an inline <a>, which glues the words together.
const splitOnEmail = (text: string) => text.split("{email}");
const introParts = splitOnEmail(intro);
const stuckParts = splitOnEmail(stuckBody);
---

<BaseLayout title={TITLE} description={META}>
  <Header />
  <main id="main">
    <SectionShell innerClass="max-w-3xl">
      <p class="font-heading text-[0.7rem] font-black uppercase tracking-[0.16em] text-muted-foreground">{eyebrow}</p>
      <h1 class="fs-xl mt-4 leading-[1.05] text-foreground">{headline}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {introParts.map((part, i) => (
          <>{i > 0 && <a class="support-link" href={`mailto:${email}`}>{email}</a>}{part}</>
        ))}
      </p>

      <ul class="mt-12 space-y-8" role="list">
        {
          topics.map((topic) => (
            <li class="support-topic">
              <h2 class="font-heading text-lg font-black text-foreground">{topic.heading}</h2>
              <p class="mt-2 leading-relaxed text-muted-foreground">{topic.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="support-panel mt-14">
        <h2 class="fs-m text-foreground">{stuckHeadline}</h2>
        <p class="mt-2 text-muted-foreground">
          {stuckParts.map((part, i) => (
            <>{i > 0 && <a class="support-link" href={`mailto:${email}`}>{email}</a>}{part}</>
          ))}
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          Looking for <a class="support-link" href="/delete-account">account deletion</a>, the <a class="support-link" href="/privacy">privacy policy</a> or the <a class="support-link" href="/terms">terms</a>?
        </p>
      </div>
    </SectionShell>
  </main>
  <Footer />
</BaseLayout>

<style>
  .support-topic {
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
  }

  .support-topic:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .support-link {
    color: var(--primary);
    font-weight: 700;
    text-underline-offset: 0.2em;
    text-decoration: underline;
  }

  .support-link:hover {
    color: var(--primary-strong);
  }

  .support-panel {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.75rem;
    box-shadow: var(--shadow-elevated);
  }
</style>
