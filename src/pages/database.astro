---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionShell from "../components/ui/SectionShell.astro";
import { canadianFoodsFigure, countedOn, foodStats, foodsFigure, formatCount, type SourceCount } from "../lib/foodStats";

// Every number here comes from src/data/food-database.json (see src/lib/foodStats.ts);
// every claim about checks traces to the import gate, the one-food-per-barcode
// trigger, the post-load sweep and the donor fill. Keep it that way.
const TITLE = "What's in the food database";
const META = `${foodsFigure}+ foods, ${canadianFoodsFigure}+ from Canadian sources: where PocketChomp's nutrition data comes from, how it is checked, and what is not covered well yet.`;

const { groups } = foodStats;
const label = (name: string) =>
  ({
    "Health Canada CNF": "Health Canada's Canadian Nutrient File",
    "OpenFoodFacts US": "Open Food Facts, United States",
    "OpenFoodFacts UK": "Open Food Facts, United Kingdom",
    "OpenFoodFacts Canada": "Open Food Facts, Canada",
    "OpenFoodFacts Australia": "Open Food Facts, Australia",
    "UK CoFID": "UK Composition of Foods Integrated Dataset",
    "AFCD Australia": "Australian Food Composition Database",
    "FCDB Denmark": "Danish Food Composition Databank",
    Other: "Other sources",
  })[name] ?? name;

const sections: { heading: string; body: string; count: number; sources: SourceCount[] }[] = [
  {
    heading: "Government reference data",
    body: "Generic foods from government food composition tables: Health Canada's Canadian Nutrient File, the USDA's databases, and the national tables of the UK, Australia and Denmark. Produce, meat, dairy, grains and cooked dishes.",
    ...groups.reference,
  },
  {
    heading: "Canadian grocery labels",
    body: "Products sold by Canadian grocers, house brands included, taken from the Nutrition Facts table on each product as the store publishes it.",
    ...groups.grocery,
  },
  {
    heading: "Canadian restaurant menus",
    body: "From each chain's published Canadian nutrition information.",
    ...groups.restaurants,
  },
  {
    heading: "Open Food Facts",
    body: "Products contributed to Open Food Facts, the open community database. These come after the sources above in search.",
    ...groups.community,
  },
];

const countOf = (name: string) => groups.grocery.sources.find((s) => s.name === name)?.count ?? 0;
---

<BaseLayout title={TITLE} description={META}>
  <Header />
  <main id="main">
    <SectionShell innerClass="max-w-3xl">
      <p class="font-heading text-[0.7rem] font-black uppercase tracking-[0.16em] text-muted-foreground">Food database</p>
      <h1 class="fs-xl mt-4 leading-[1.05] text-foreground">{TITLE}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {foodsFigure}+ foods anyone can search, {canadianFoodsFigure}+ of them from Canadian sources. Counted {countedOn}; the
        headline figures are rounded down to the nearest thousand.
      </p>

      <h2 class="fs-m mt-14 text-foreground">Where the foods come from</h2>
      {
        sections.map((section) => (
          <section class="db-group">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-heading text-lg font-black text-foreground">{section.heading}</h3>
              <p class="font-heading font-black text-foreground">{formatCount(section.count)}</p>
            </div>
            <p class="mt-2 leading-relaxed text-muted-foreground">{section.body}</p>
            <ul class="db-sources mt-4" role="list">
              {section.sources.map((source) => (
                <li>
                  <span>{label(source.name)}</span>
                  <span class="tabular-nums">{formatCount(source.count)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <h2 class="fs-m mt-14 text-foreground">How entries are checked</h2>
      <ul class="db-list mt-5" role="list">
        <li>Nutrition is stored per 100 g, scaled from the source's own figures.</li>
        <li>
          Every import runs the same checks. Calories have to fit the protein, carbs and fat. Nothing can hold more than
          100 g of nutrients per 100 g. A value past a physical limit, like milligrams typed as grams, is stored as
          unknown rather than guessed.
        </li>
        <li>A value the source leaves out stays unknown. It is never filled in as zero.</li>
        <li>
          When a store label leaves a nutrient out, the app can borrow it from a closely matched Health Canada or USDA
          food, and marks it as an estimate.
        </li>
        <li>One visible food per barcode, so a scan never turns up duplicates.</li>
        <li>After every load, a sweep re-checks every visible food against the same rules.</li>
      </ul>

      <h2 class="fs-m mt-14 text-foreground">What isn't covered well yet</h2>
      <ul class="db-list mt-5" role="list">
        <li>
          Costco ({formatCount(countOf("Costco"))} foods) and Walmart ({formatCount(countOf("Walmart"))}) are thin. Their
          other products come from Open Food Facts when someone has added them there.
        </li>
        <li>US store brands are thinner than Canadian ones.</li>
        <li>Restaurant menus cover {groups.restaurants.sources.length} chains.</li>
        <li>
          Gum, spices, instant coffee and other products with a serving of a gram or two print rounded numbers for that
          tiny serving. Logged by the serving they match the package; logged by weight they are approximate.
        </li>
        <li>Missing something? Scan its nutrition label in the app to add it for yourself.</li>
      </ul>

      <section id="request" class="request-panel mt-14">
        <h2 class="fs-m text-foreground">Request a store or restaurant</h2>
        <p class="mt-2 leading-relaxed text-muted-foreground">
          Have a suggestion for a specific store or restaurant? Request it below and I'll see what I can do.
        </p>
        <form class="request-form mt-5" action="/api/food-request" method="post" data-request-form>
          <label class="sr-only" for="request-text">Store or restaurant</label>
          <input
            id="request-text"
            name="request"
            type="text"
            required
            minlength="2"
            maxlength="50"
            autocomplete="off"
            placeholder="e.g. Sobeys, A&W, Loblaws"
          />
          <!-- Honeypot: hidden from people, filled by bots. -->
          <div class="request-hp" aria-hidden="true">
            <label for="request-website">Website</label>
            <input id="request-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit">Send</button>
        </form>
        <p class="request-status mt-3" role="status" aria-live="polite" data-request-status></p>
        <p class="mt-3 text-sm text-muted-foreground">Only what you type is kept. No name, email or IP address.</p>
      </section>
    </SectionShell>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Submits in place and reports the result; without JS the form posts and
  // the worker redirects back with ?requested=ok|limit|error.
  const MESSAGES: Record<string, string> = {
    ok: "Thanks, got it.",
    limit: "That's a few in a row. Try again in a minute.",
    error: "That didn't send. Try again in a moment.",
  };
  const form = document.querySelector<HTMLFormElement>("[data-request-form]");
  const status = document.querySelector<HTMLElement>("[data-request-status]");

  const show = (outcome: string) => {
    if (status) status.textContent = MESSAGES[outcome] ?? MESSAGES.error;
  };

  const fromRedirect = new URLSearchParams(location.search).get("requested");
  if (fromRedirect) show(fromRedirect);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button");
    if (button) button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const body = (await res.json().catch(() => ({}))) as { outcome?: string };
      show(body.outcome ?? "error");
      if (body.outcome === "ok") form.reset();
    } catch {
      show("error");
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .request-panel {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.75rem;
  }

  .request-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
  }

  .request-form input[name="request"] {
    flex: 1;
    min-width: 0;
    padding: 0 1.1rem;
    background: transparent;
    color: var(--foreground);
    font-size: 1rem;
  }

  .request-form input[name="request"]:focus {
    outline: none;
  }

  .request-form:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .request-form button {
    flex: none;
    height: 3rem;
    padding: 0 1.4rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .request-form button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .request-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .request-status:empty {
    display: none;
  }

  .request-status {
    font-weight: 600;
    color: var(--foreground);
  }

  .db-group {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
  }

  .db-sources li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    color: var(--muted-foreground);
    border-bottom: 1px dashed color-mix(in oklab, var(--border) 50%, transparent);
  }

  .db-list {
    display: grid;
    gap: 0.9rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--muted-foreground);
    line-height: 1.65;
  }
</style>
