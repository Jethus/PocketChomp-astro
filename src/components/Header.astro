---
import Button from "./ui/Button.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";
import logoLight from "../assets/svgs/logo-light.svg";
import logoDark from "../assets/svgs/logo-dark.svg";
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl">
  <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-4 px-6 py-4">
    <a href="/" aria-label="PocketChomp home" class="inline-flex items-center">
      <span class="logo-light">
        <img src={logoLight.src} alt="PocketChomp" class="h-10 w-auto sm:h-14" />
      </span>
      <span class="logo-dark">
        <img src={logoDark.src} alt="PocketChomp" class="h-10 w-auto sm:h-14" />
      </span>
    </a>

    <div class="flex items-center gap-3">
      <a
        href="/tools/tdee-calculator"
        class="hidden font-body text-[0.9rem] font-bold text-muted-foreground transition-colors hover:text-foreground sm:inline-flex"
      >
        TDEE Calculator
      </a>
      <a
        href="/tools/calorie-deficit-calculator"
        class="hidden font-body text-[0.9rem] font-bold text-muted-foreground transition-colors hover:text-foreground sm:inline-flex"
      >
        Deficit Calculator
      </a>
      <ThemeToggle />
      <Button href="#signup" size="md" variant="accent">Join the beta</Button>
    </div>
  </div>
</header>

<style>
  .logo-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .logo-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .logo-dark {
    display: inline-flex;
  }
</style>
