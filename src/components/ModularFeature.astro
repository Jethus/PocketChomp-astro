---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import SectionShell from "./ui/SectionShell.astro";
import AppPanel from "./ui/AppPanel.astro";

const featureEntry = await getEntry("landingModularFeature", "modular-feature");

if (!featureEntry) {
  throw new Error("Could not find PocketChomp modular feature content");
}

const { eyebrow, headline, description, bullets, panelLabel, image, imageAlt } = featureEntry.data;
---

<SectionShell
  id="modular"
  class="pt-6"
  innerClass="overflow-hidden rounded-[2rem] bg-primary px-6 py-10 md:px-10 md:py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(17rem,0.85fr)] lg:items-center lg:gap-12"
  data-reveal-root
>
  <div>
    <p class="font-heading text-[0.68rem] font-black uppercase tracking-[0.22em] text-white/60">
      {eyebrow}
    </p>
    <h2 class="modular-headline fs-xl mt-3 max-w-[14ch] leading-[1.04] text-white">
      {headline}
    </h2>
    <p class="modular-body mt-5 max-w-[40ch] text-lg leading-relaxed text-white/78">
      {description}
    </p>

    <ul class="modular-list mt-8 grid max-w-[40ch] gap-y-3">
      {
        bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-base font-medium leading-snug text-white">
            <span class="modular-check" aria-hidden="true">
              <svg viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="56" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="96 272 208 368 416 144" />
              </svg>
            </span>
            {bullet}
          </li>
        ))
      }
    </ul>
  </div>

  <AppPanel label={panelLabel} class="mx-auto mt-10 max-w-sm lg:mt-0 lg:max-w-none">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960]}
      sizes="(max-width: 64rem) 80vw, 24rem"
      loading="lazy"
      decoding="async"
    />
  </AppPanel>
</SectionShell>

<style>
  /* Balanced wrapping so the headline never strands a short word, and the
     body and list wrap "pretty" so no line ends on a lone word. */
  .modular-headline {
    text-wrap: balance;
  }

  .modular-body,
  .modular-list li {
    text-wrap: pretty;
  }

  /* A bare bold check, no ring: the app's list marks are glyphs on paper. */
  .modular-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: oklch(1 0 0);
  }

  .modular-check svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
