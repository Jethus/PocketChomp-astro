---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import SectionShell from "./ui/SectionShell.astro";
import AppPanel from "./ui/AppPanel.astro";

const featureEntry = await getEntry("landingModularFeature", "modular-feature");

if (!featureEntry) {
  throw new Error("Could not find PocketChomp modular feature content");
}

const { eyebrow, headline, description, bullets, panelLabel, image, imageAlt } = featureEntry.data;
---

<SectionShell
  id="modular"
  class="pt-6"
  innerClass="overflow-hidden rounded-[2.5rem] bg-primary px-6 py-10 shadow-[var(--shadow-elevated-lg)] md:px-10 md:py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(15rem,0.7fr)] lg:items-center lg:gap-14"
  data-reveal-root
>
  <div>
    <p class="font-heading text-[0.68rem] font-black uppercase tracking-[0.22em] text-white/60">
      {eyebrow}
    </p>
    <h2 class="fs-xl mt-3 max-w-[10ch] leading-[1.04] text-white">
      {headline}
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
      {description}
    </p>

    <ul class="mt-9 grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {
        bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-base font-medium leading-relaxed text-white">
            <span class="modular-check" aria-hidden="true">
              <svg viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="56" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="96 272 208 368 416 144" />
              </svg>
            </span>
            {bullet}
          </li>
        ))
      }
    </ul>
  </div>

  <AppPanel label={panelLabel} class="mx-auto mt-10 max-w-sm lg:mt-0 lg:max-w-none">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960]}
      sizes="(max-width: 64rem) 80vw, 24rem"
      loading="lazy"
      decoding="async"
    />
  </AppPanel>
</SectionShell>

<style>
  .modular-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
    border-radius: 999px;
    border: 1px solid oklch(1 0 0 / 0.28);
    background: oklch(1 0 0 / 0.14);
    color: oklch(0.97 0.005 145);
  }

  .modular-check svg {
    width: 0.8rem;
    height: 0.8rem;
  }
</style>
