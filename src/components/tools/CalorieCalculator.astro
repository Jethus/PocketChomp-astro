---
interface Props {
  mode: "tdee" | "deficit" | "bmr" | "macro";
}

const { mode } = Astro.props;

// BMR is a resting figure — activity, goal and pace don't enter the formula,
// so the form drops them rather than showing inputs that change nothing.
const isBmr = mode === "bmr";
const isMacro = mode === "macro";
const isTdee = mode === "tdee";
const isDeficit = mode === "deficit";

// Shared vocabulary with the app's DIET_STYLE_OPTIONS.
const splitOptions = [
  { value: "balanced", label: "Balanced — steady all-round eating" },
  { value: "high_protein", label: "High protein — lifting, cutting, satiety" },
  { value: "low_carb", label: "Lower carb — higher fat, fewer carbs" },
  { value: "low_fat", label: "Low fat — more carbs, less fat" },
  { value: "keto", label: "Keto — carbs capped near 30 g/day" },
];

/**
 * Non-exercise activity only. Training is asked separately below, so these
 * descriptions must NOT mention exercise — a user who reads "exercise most
 * days" here and then also answers "5 sessions a week" has described the same
 * training twice and their target reads high. Wording and the step-count
 * anchors mirror PocketChomp/constants/activity.ts.
 */
const activityOptions = [
  { value: "sedentary", label: "Mostly sedentary — under 5,000 steps a day" },
  { value: "light", label: "Lightly active — around 5,000–7,500 steps" },
  { value: "moderate", label: "Moderately active — around 7,500–10,000 steps" },
  { value: "active", label: "Active — on the move, 10,000–12,500 steps" },
  { value: "very_active", label: "Very active — physical job, 12,500+ steps" },
];

/** Representative days/week per band — midpoints, matching the app. */
const exerciseOptions = [
  { value: "0", label: "None — no structured exercise" },
  { value: "2", label: "1–3 sessions a week" },
  { value: "5", label: "4–6 sessions a week" },
  { value: "7", label: "7+ sessions a week" },
];

const paceOptions = [
  { value: "0.25", label: "Gentle — 0.25 kg (½ lb) / week" },
  { value: "0.5", label: "Moderate — 0.5 kg (1 lb) / week" },
  { value: "0.75", label: "Fast — 0.75 kg (1½ lb) / week" },
  { value: "1", label: "Aggressive — 1 kg (2 lb) / week" },
];

// Macro pages default to "lose" alongside the deficit page: most people setting
// macros are cutting, and the maintain branch drops protein to 1.2–1.6 g/kg,
// which would open a macro calculator on a low-protein recommendation.
const defaultGoal = mode === "deficit" || mode === "macro" ? "lose" : "maintain";
---

<div class="calc" data-calculator data-mode={mode}>
  <form class="calc__form" data-calc-form>
    <fieldset class="calc__field">
      <legend class="calc__label">Units</legend>
      <div class="calc__segmented" role="group">
        <label><input type="radio" name="units" value="imperial" checked /> lbs / ft</label>
        <label><input type="radio" name="units" value="metric" /> kg / cm</label>
      </div>
    </fieldset>

    <fieldset class="calc__field">
      <legend class="calc__label">Sex</legend>
      <div class="calc__segmented" role="group">
        <label><input type="radio" name="sex" value="female" checked /> Female</label>
        <label><input type="radio" name="sex" value="male" /> Male</label>
      </div>
    </fieldset>

    <div class="calc__field">
      <label class="calc__label" for="calc-age">Age</label>
      <input id="calc-age" name="age" type="number" inputmode="numeric" min="16" max="100" placeholder="30" />
    </div>

    <div class="calc__field" data-imperial>
      <label class="calc__label" for="calc-ft">Height</label>
      <div class="calc__pair">
        <input id="calc-ft" name="heightFt" type="number" inputmode="numeric" min="3" max="7" placeholder="5" aria-label="feet" />
        <span>ft</span>
        <input name="heightIn" type="number" inputmode="numeric" min="0" max="11" placeholder="10" aria-label="inches" />
        <span>in</span>
      </div>
    </div>
    <div class="calc__field" data-metric hidden>
      <label class="calc__label" for="calc-cm">Height (cm)</label>
      <input id="calc-cm" name="heightCm" type="number" inputmode="numeric" min="100" max="230" placeholder="178" />
    </div>

    <div class="calc__field" data-imperial>
      <label class="calc__label" for="calc-lbs">Weight (lbs)</label>
      <input id="calc-lbs" name="weightLbs" type="number" inputmode="decimal" min="70" max="700" placeholder="176" />
    </div>
    <div class="calc__field" data-metric hidden>
      <label class="calc__label" for="calc-kg">Weight (kg)</label>
      <input id="calc-kg" name="weightKg" type="number" inputmode="decimal" min="35" max="320" placeholder="80" />
    </div>

    <div class="calc__field" hidden={isBmr}>
      <label class="calc__label" for="calc-activity">Activity</label>
      <select id="calc-activity" name="activity">
        {activityOptions.map((o) => (
          <option value={o.value} selected={o.value === "moderate"}>{o.label}</option>
        ))}
      </select>
    </div>

    <div class="calc__field" hidden={isBmr}>
      <label class="calc__label" for="calc-exercise">Exercise</label>
      <select id="calc-exercise" name="exercise">
        {exerciseOptions.map((o) => (
          <option value={o.value} selected={o.value === "2"}>{o.label}</option>
        ))}
      </select>
    </div>

    <div class="calc__field" hidden={isBmr}>
      <label class="calc__label" for="calc-goal">Goal</label>
      <select id="calc-goal" name="goal">
        <option value="lose" selected={defaultGoal === "lose"}>Lose weight</option>
        <option value="maintain" selected={defaultGoal === "maintain"}>Maintain</option>
        <option value="gain">Gain weight</option>
      </select>
    </div>

    <div class="calc__field" data-pace-row hidden={isBmr || defaultGoal === "maintain"}>
      <label class="calc__label" for="calc-pace">Pace</label>
      <select id="calc-pace" name="pace">
        {paceOptions.map((o) => (
          <option value={o.value} selected={o.value === "0.5"}>{o.label}</option>
        ))}
      </select>
    </div>

    {isDeficit && (
      <div class="calc__field" data-goal-weight-row>
        <label class="calc__label" for="calc-goal-weight">
          Goal weight <span class="calc__optional">optional</span>
        </label>
        <input
          id="calc-goal-weight"
          name="goalWeight"
          type="number"
          inputmode="decimal"
          min="30"
          max="700"
          placeholder="Add one for a timeline"
        />
      </div>
    )}

    {isMacro && (
      <div class="calc__field calc__field--wide">
        <label class="calc__label" for="calc-split">Macro split</label>
        <select id="calc-split" name="split">
          {splitOptions.map((o) => (
            <option value={o.value} selected={o.value === "balanced"}>{o.label}</option>
          ))}
        </select>
      </div>
    )}
  </form>

  <aside class="calc__summary" data-results aria-live="polite">
    <p class="calc__placeholder" data-placeholder>
      Fill in your details — your plan appears here instantly. Nothing is
      stored or sent anywhere.
    </p>

    <div class="calc__numbers" data-numbers hidden>
      <p class="calc__summary-label" data-out="target-label">Your daily target</p>
      <p class="calc__summary-value"><span data-out="target">—</span></p>
      <p class="calc__summary-unit">kcal/day</p>
      <p class="calc__delta" data-delta><span data-out="delta">—</span></p>

      {isTdee && (
        <div class="breakdown" data-breakdown>
          <p class="breakdown__title">Where that goes</p>
          <ul class="breakdown__list">
            <li>
              <span class="breakdown__label">At rest (BMR)</span>
              <span class="breakdown__val"><span data-out="eb-bmr">—</span></span>
            </li>
            <li>
              <span class="breakdown__label">Daily movement</span>
              <span class="breakdown__val"><span data-out="eb-neat">—</span></span>
            </li>
            <li data-row="eb-training">
              <span class="breakdown__label">Training</span>
              <span class="breakdown__val"><span data-out="eb-training">—</span></span>
            </li>
            <li>
              <span class="breakdown__label">Digesting food</span>
              <span class="breakdown__val"><span data-out="eb-digestion">—</span></span>
            </li>
          </ul>
          <p class="breakdown__note">
            An attribution of the estimate, not four separate measurements.
          </p>
        </div>
      )}

      {isDeficit && (
        <div class="timeline" data-timeline hidden>
          <p class="timeline__lead">
            At this pace you'd reach <span data-out="tl-goal">—</span> around
          </p>
          <p class="timeline__date" data-out="tl-date">—</p>
          <p class="timeline__note">
            <span data-out="tl-weeks">—</span> — and that's the optimistic
            version. Loss slows as you get lighter, so treat it as a floor.
          </p>
        </div>
      )}

      {isMacro && (
        <div class="macrobar" data-macrobar aria-hidden="true">
          <span class="macrobar__seg macrobar__seg--p" data-bar="protein"></span>
          <span class="macrobar__seg macrobar__seg--c" data-bar="carbs"></span>
          <span class="macrobar__seg macrobar__seg--f" data-bar="fat"></span>
        </div>
      )}

      {isMacro && (
        <ul class="macrokeys" data-macrokeys>
          <li><span class="macrokeys__dot macrokeys__dot--p"></span>Protein <b><span data-out="m-protein-g">—</span>g</b> <i><span data-out="m-protein-p">—</span>%</i></li>
          <li><span class="macrokeys__dot macrokeys__dot--c"></span>Carbs <b><span data-out="m-carbs-g">—</span>g</b> <i><span data-out="m-carbs-p">—</span>%</i></li>
          <li><span class="macrokeys__dot macrokeys__dot--f"></span>Fat <b><span data-out="m-fat-g">—</span>g</b> <i><span data-out="m-fat-p">—</span>%</i></li>
        </ul>
      )}

      <dl class="calc__rows">
        <div class="calc__row-line" data-row="maintenance">
          <dt>Maintenance (TDEE)</dt>
          <dd><span data-out="maintenance">—</span> kcal</dd>
        </div>
        <div class="calc__row-line" data-row="protein" hidden={isMacro}>
          <dt>Protein</dt>
          <dd><span data-out="protein">—</span> g</dd>
        </div>
        <div class="calc__row-line" data-row="macro-split" hidden={isMacro}>
          <dt>Split P&hairsp;/&hairsp;C&hairsp;/&hairsp;F</dt>
          <dd><span data-out="macro-split">—</span></dd>
        </div>
        <div class="calc__row-line" data-row="bmr">
          <dt>BMR</dt>
          <dd><span data-out="bmr">—</span> kcal</dd>
        </div>
      </dl>

      <p class="calc__warning" data-warning hidden>
        That pace puts your target below a safe floor for your stats. Pick a
        slower pace — a deficit you can sustain beats one that burns you out.
      </p>

      <p class="calc__privacy">Runs in your browser. Nothing is stored or sent.</p>
    </div>
  </aside>
</div>

<script>
  import {
    calculate,
    feetInchesToCm,
    lbsToKg,
    projectGoalDate,
    LBS_PER_KG,
    type ActivityLevel,
    type Goal,
    type MacroSplit,
    type Sex,
  } from "../../lib/calculator/engine";

  document.querySelectorAll<HTMLElement>("[data-calculator]").forEach((root) => {
    const mode = root.dataset.mode ?? "tdee";
    const isBmr = mode === "bmr";
    const isMacro = mode === "macro";
    const isTdee = mode === "tdee";
    const isDeficit = mode === "deficit";
    const form = root.querySelector<HTMLFormElement>("[data-calc-form]")!;
    const out = (name: string) =>
      root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
    const numbersEl = root.querySelector<HTMLElement>("[data-numbers]")!;
    const placeholderEl = root.querySelector<HTMLElement>("[data-placeholder]")!;
    const warningEl = root.querySelector<HTMLElement>("[data-warning]")!;
    const deltaEl = root.querySelector<HTMLElement>("[data-delta]")!;
    const summaryEl = root.querySelector<HTMLElement>("[data-results]")!;
    const maintenanceRow = root.querySelector<HTMLElement>('[data-row="maintenance"]')!;
    const paceRow = root.querySelector<HTMLElement>("[data-pace-row]")!;
    const timelineEl = root.querySelector<HTMLElement>("[data-timeline]");

    const num = (name: string): number => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      const v = parseFloat(el?.value ?? "");
      return Number.isFinite(v) ? v : NaN;
    };
    const val = (name: string): string =>
      (form.elements.namedItem(name) as RadioNodeList | HTMLSelectElement).value;

    const fmt = (r: { low: number; high: number }) =>
      `${r.low.toLocaleString()}–${r.high.toLocaleString()}`;

    const render = () => {
      const metric = val("units") === "metric";
      root
        .querySelectorAll<HTMLElement>("[data-imperial]")
        .forEach((el) => (el.hidden = metric));
      root
        .querySelectorAll<HTMLElement>("[data-metric]")
        .forEach((el) => (el.hidden = !metric));

      // BMR ignores goal entirely; treat it as maintenance so the shared engine
      // call stays on one path and no deficit is ever applied to a resting figure.
      const goal = (isBmr ? "maintain" : val("goal")) as Goal;
      paceRow.hidden = isBmr || goal === "maintain";

      const age = num("age");
      const heightCm = metric
        ? num("heightCm")
        : feetInchesToCm(num("heightFt"), num("heightIn") || 0);
      const weightKg = metric ? num("weightKg") : lbsToKg(num("weightLbs"));

      const valid =
        age >= 16 && age <= 100 && heightCm >= 100 && heightCm <= 230 &&
        weightKg >= 35 && weightKg <= 320;

      placeholderEl.hidden = valid;
      summaryEl.classList.toggle("calc__summary--live", valid);
      if (!valid) {
        numbersEl.hidden = true;
        return;
      }

      const splitEl = form.elements.namedItem("split") as HTMLSelectElement | null;
      const exerciseEl = form.elements.namedItem(
        "exercise",
      ) as HTMLSelectElement | null;
      const activeDaysPerWeek = exerciseEl ? parseFloat(exerciseEl.value) : 0;

      const result = calculate({
        age,
        sex: val("sex") as Sex,
        heightCm,
        weightKg,
        activity: val("activity") as ActivityLevel,
        activeDaysPerWeek,
        goal,
        paceKgPerWeek: goal === "maintain" ? 0 : parseFloat(val("pace")),
        split: (splitEl?.value as MacroSplit) ?? "balanced",
      });

      // BMR mode: the resting figure is the headline, and nothing below it
      // (maintenance, deficit, macros) belongs on a page about resting burn.
      if (isBmr) {
        out("target-label").textContent = "Your BMR";
        out("target").textContent = result.bmr.toLocaleString();
        deltaEl.hidden = true;
        maintenanceRow.hidden = true;
        root.querySelector<HTMLElement>('[data-row="protein"]')!.hidden = true;
        root.querySelector<HTMLElement>('[data-row="macro-split"]')!.hidden = true;
        root.querySelector<HTMLElement>('[data-row="bmr"]')!.hidden = true;
        warningEl.hidden = true;
        numbersEl.hidden = false;
        return;
      }

      const aggressive = result.warning === "aggressive_pace";
      // With an unsafe pace the target is not worth headlining — fall back to
      // maintenance up top and let the warning explain why.
      const showTarget = goal !== "maintain" && !aggressive;

      out("target").textContent = fmt(showTarget ? result.target : result.maintenance);
      out("target-label").textContent = showTarget
        ? goal === "lose"
          ? "Deficit target"
          : "Surplus target"
        : "Maintenance (TDEE)";

      const adj = result.dailyAdjustment;
      deltaEl.classList.toggle("calc__delta--neutral", !showTarget);
      out("delta").textContent = !showTarget
        ? "At maintenance — no deficit or surplus"
        : adj < 0
          ? `−${Math.abs(adj).toLocaleString()} kcal/day deficit`
          : `+${adj.toLocaleString()} kcal/day surplus`;
      deltaEl.hidden = aggressive;

      maintenanceRow.hidden = !showTarget;
      out("maintenance").textContent = fmt(result.maintenance);
      out("bmr").textContent = result.bmr.toLocaleString();

      if (isTdee) {
        const e = result.energyBreakdown;
        out("eb-bmr").textContent = `${e.bmr.toLocaleString()} kcal`;
        out("eb-neat").textContent = `${e.neat.toLocaleString()} kcal`;
        out("eb-training").textContent = `${e.training.toLocaleString()} kcal`;
        out("eb-digestion").textContent = `${e.digestion.toLocaleString()} kcal`;
        // A "Training: 0 kcal" row reads like a bug to someone who told us they
        // don't train; drop it instead.
        const trainingRow = root.querySelector<HTMLElement>('[data-row="eb-training"]');
        if (trainingRow) trainingRow.hidden = e.training <= 0;
      }

      if (isDeficit && timelineEl) {
        const goalRaw = num("goalWeight");
        const goalKg = metric ? goalRaw : lbsToKg(goalRaw);
        const pace = goal === "maintain" ? 0 : parseFloat(val("pace"));
        const projection =
          Number.isFinite(goalKg) && goalKg > 0
            ? projectGoalDate(weightKg - goalKg, pace)
            : null;

        // Only project when the goal actually lies in the direction of travel —
        // a goal above current weight while losing is a typo, not a plan.
        const directionOk =
          projection &&
          ((goal === "lose" && goalKg < weightKg) ||
            (goal === "gain" && goalKg > weightKg));

        if (projection && directionOk) {
          const unit = metric ? "kg" : "lbs";
          const shown = metric ? goalKg : goalKg * LBS_PER_KG;
          out("tl-goal").textContent = `${Math.round(shown * 10) / 10} ${unit}`;
          out("tl-date").textContent = projection.date.toLocaleDateString("en-CA", {
            month: "long",
            year: "numeric",
          });
          out("tl-weeks").textContent = `About ${projection.weeks} weeks`;
          timelineEl.hidden = false;
        } else {
          timelineEl.hidden = true;
        }
      }

      if (isMacro) {
        // At an unsafe pace the headline falls back to maintenance, so the
        // macros must follow it. Splitting the rejected target instead leaves
        // almost nothing after protein and renders an absurd ~93% protein bar.
        const macroSource = aggressive
          ? calculate({
              age,
              sex: val("sex") as Sex,
              heightCm,
              weightKg,
              activity: val("activity") as ActivityLevel,
              activeDaysPerWeek,
              goal: "maintain",
              paceKgPerWeek: 0,
              split: (splitEl?.value as MacroSplit) ?? "balanced",
            })
          : result;
        const { protein, carbs, fat } = macroSource.macroPercents;
        // The site ships a strict CSP with no 'unsafe-inline' for styles, which
        // drops inline style *attributes* in markup. Setting a property through
        // the CSSOM at runtime is not an inline attribute and is unaffected —
        // verified against a production build, see the macrobar width check.
        const bar = (n: string, pct: number) => {
          const el = root.querySelector<HTMLElement>(`[data-bar="${n}"]`);
          if (el) el.style.setProperty("--seg", String(pct));
        };
        bar("protein", protein);
        bar("carbs", carbs);
        bar("fat", fat);
        out("m-protein-g").textContent = String(macroSource.macros.proteinG);
        out("m-carbs-g").textContent = String(macroSource.macros.carbsG);
        out("m-fat-g").textContent = String(macroSource.macros.fatG);
        out("m-protein-p").textContent = String(protein);
        out("m-carbs-p").textContent = String(carbs);
        out("m-fat-p").textContent = String(fat);
      } else {
        out("protein").textContent = fmt(result.proteinG);
        out("macro-split").textContent =
          `${result.macros.proteinG} / ${result.macros.carbsG} / ${result.macros.fatG} g`;
      }

      warningEl.hidden = !aggressive;
      numbersEl.hidden = false;
    };

    form.addEventListener("input", render);
    render();
  });
</script>

<style>
  .calc {
    border-radius: 1.6rem;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
    padding: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  /* Form left, result card right — the whole tool reads as one unit */
  @media (min-width: 56rem) {
    .calc {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
      padding: 1.75rem;
      gap: 1.75rem;
    }
  }

  .calc__form {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 26rem) {
    .calc__form {
      grid-template-columns: 1fr 1fr;
    }
  }

  .calc__field {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .calc__label {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .calc input[type="number"],
  .calc select {
    height: 2.75rem;
    border-radius: 0.8rem;
    border: 1px solid var(--border);
    background: var(--background);
    padding: 0 0.8rem;
    color: var(--foreground);
    width: 100%;
    font-size: 0.95rem;
  }

  .calc input:focus-visible,
  .calc select:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  .calc__pair {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .calc__pair span {
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }

  .calc__segmented {
    display: flex;
    gap: 0.5rem;
  }

  .calc__segmented label {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    border: 1px solid var(--border);
    background: var(--background);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .calc__segmented label:has(input:checked) {
    border-color: var(--primary);
    background: color-mix(in oklab, var(--primary) 10%, var(--background));
    font-weight: 700;
    color: var(--primary-strong);
  }

  .calc__segmented label:has(input:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  /* App-style segments: the state shows in the fill, not a radio dot */
  .calc__segmented input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Result card mirrors the app's goal-summary card: bold accent border,
     one big kcal number, the deficit/surplus called out right under it */
  /* Quiet until there are numbers — the accent frame is the reward state,
     not an alert around the placeholder text */
  .calc__summary {
    border-radius: 1.2rem;
    border: 2px dashed var(--border);
    background: var(--surface-strong);
    padding: 1.5rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .calc__summary--live {
    border: 2px solid var(--accent-strong);
    background: color-mix(in oklab, var(--accent) 4%, var(--surface));
  }

  .calc__placeholder {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.5;
    text-align: center;
  }

  .calc__summary-label {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    text-align: center;
  }

  /* The headline is a calorie figure, so it carries the app's calories colour
     rather than the generic accent — same number, same colour, both products. */
