---
import { getCollection } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

function readTime(body: string): string {
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min read`;
}
---

<SectionShell class="border-b border-border">
  <div class="mx-auto max-w-3xl">

    <!-- Eyebrow -->
    <p class="teaser-eyebrow mb-6 text-[0.7rem] font-heading font-black uppercase tracking-[0.18em] text-muted-foreground">
      Field Notes
    </p>

    <!-- Headline -->
    <h2 class="font-heading font-black uppercase leading-[0.93] tracking-tight">
      From the <span class="text-accent">build log.</span>
    </h2>

    <!-- Post rows -->
    <div class="mt-10 divide-y divide-border">
      {posts.map((post) => {
        const d = post.data.pubDate;
        const date = d.toLocaleDateString("en-CA", {
          month: "short",
          day: "numeric",
          year: "numeric",
          timeZone: "UTC",
        }).toUpperCase();
        const rt = readTime(post.body ?? "");
        return (
          <a href={`/blog/${post.id}`} class="teaser-row group">
            <div class="min-w-0 flex-1">
              <h3 class="teaser-title">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 max-w-[60ch] text-sm leading-relaxed text-muted-foreground">
                {post.data.description}
              </p>
            </div>
            <div class="teaser-meta shrink-0 text-right">
              <span class="block font-mono text-[0.68rem] text-muted-foreground">{date}</span>
              <span class="block font-mono text-[0.68rem] text-muted-foreground">{rt}</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- All posts link -->
    <div class="mt-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-mono text-[0.75rem] tracking-[0.05em] text-muted-foreground transition-colors hover:text-accent"
      >
        All Field Notes →
      </a>
    </div>

  </div>
</SectionShell>

<style>
  .teaser-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .teaser-eyebrow::before {
    content: "";
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .teaser-row {
    display: flex;
    gap: 2rem;
    align-items: start;
    padding: 1.75rem 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.2s ease;
  }
  .teaser-row:hover {
    padding-left: 0.5rem;
  }

  .teaser-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0;
    color: var(--color-foreground);
    transition: color 0.2s;
  }
  .teaser-row:hover .teaser-title {
    color: var(--color-accent);
  }

  .teaser-meta {
    padding-top: 0.2rem;
    min-width: 7rem;
  }
</style>
