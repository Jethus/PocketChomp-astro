---
import SectionShell from "./ui/SectionShell.astro";
import Button from "./ui/Button.astro";
import { getPublishedPosts } from "../lib/blog";

// Editorial, not cards: the newest post leads in large type, the next three
// sit under it in columns divided by rules, the way MacroFactor and most
// publications lay out a front page. Each post's whole block is the link.
function readTime(body: string): string {
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min read`;
}

const posts = (await getPublishedPosts()).slice(0, 4).map((post) => ({
  href: `/blog/${post.id}`,
  title: post.data.title,
  description: post.data.description,
  meta: `${post.data.pubDate.toLocaleDateString("en-CA", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })} · ${readTime(post.body ?? "")}`,
}));

const [lead, ...rest] = posts;
---

<SectionShell data-reveal-root>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="teaser-eyebrow mb-5 text-[0.7rem] font-heading font-black uppercase tracking-[0.18em] text-muted-foreground">
        Field Notes
      </p>
      <h2 class="fs-xl leading-[1.02] text-foreground">
        From the <span class="text-accent">build log.</span>
      </h2>
    </div>
    <Button href="/blog" variant="outline" size="md">All Field Notes</Button>
  </div>

  {lead && (
    <a href={lead.href} class="notes-lead" data-reveal>
      <p class="notes-meta">{lead.meta}</p>
      <h3 class="notes-lead__title">{lead.title}</h3>
      <p class="notes-lead__body">{lead.description}</p>
    </a>
  )}

  <div class="notes-rest">
    {rest.map((post, index) => (
      <a href={post.href} class="notes-item" data-reveal data-index={index}>
        <p class="notes-meta">{post.meta}</p>
        <h3 class="notes-item__title">{post.title}</h3>
        <p class="notes-item__body">{post.description}</p>
      </a>
    ))}
  </div>
</SectionShell>

<style>
  .teaser-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .teaser-eyebrow::before {
    content: "";
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .notes-lead,
  .notes-item {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .notes-meta {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  /* Lead: under a heavy rule, title at display size. */
  .notes-lead {
    margin-top: 2.5rem;
    border-top: 2px solid var(--foreground);
    padding: 1.75rem 0 2.25rem;
  }

  .notes-lead__title {
    margin: 0.75rem 0 0;
    max-width: 22ch;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    line-height: 1.02;
    color: var(--foreground);
    transition: color 150ms ease-out;
  }

  .notes-lead__body {
    margin: 1rem 0 0;
    max-width: 60ch;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notes-rest {
    display: grid;
    border-top: 1px solid color-mix(in oklab, var(--foreground) 16%, transparent);
  }

  .notes-item {
    padding: 1.5rem 0;
  }

  .notes-item + .notes-item {
    border-top: 1px solid color-mix(in oklab, var(--foreground) 16%, transparent);
  }

  @media (min-width: 48rem) {
    .notes-rest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .notes-item {
      padding: 1.5rem 1.75rem 0.5rem;
    }

    .notes-item:first-child {
      padding-left: 0;
    }

    .notes-item + .notes-item {
      border-top: 0;
      border-left: 1px solid color-mix(in oklab, var(--foreground) 16%, transparent);
    }
  }

  .notes-item__title {
    margin: 0.6rem 0 0;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.15rem, 1rem + 0.4vw, 1.35rem);
    line-height: 1.2;
    color: var(--foreground);
    transition: color 150ms ease-out;
  }

  .notes-item__body {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Hover and keyboard focus: the title takes the ember text colour and
     underlines, so the link is unmistakable without a "Read" control. */
  .notes-lead:hover .notes-lead__title,
  .notes-item:hover .notes-item__title,
  .notes-lead:focus-visible .notes-lead__title,
  .notes-item:focus-visible .notes-item__title {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .notes-lead:focus-visible,
  .notes-item:focus-visible {
    outline: none;
  }

  /* Stagger in CSS; inline style attributes are blocked by the site CSP */
  .notes-item[data-index="1"] { --reveal-delay: 100ms; }
  .notes-item[data-index="2"] { --reveal-delay: 200ms; }
</style>
