---
import SectionShell from "./ui/SectionShell.astro";
import Button from "./ui/Button.astro";
import { getPublishedPosts } from "../lib/blog";

// Four most recent posts as slab cards. The old two-row list was reading as
// a footnote; the app's card grammar (white slab, grey label on top, the
// title as the loud thing) gives the writing the same weight as a feature.
function readTime(body: string): string {
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min read`;
}

const cards = (await getPublishedPosts()).slice(0, 4).map((post) => ({
  href: `/blog/${post.id}`,
  title: post.data.title,
  description: post.data.description,
  meta: `${post.data.pubDate.toLocaleDateString("en-CA", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })} · ${readTime(post.body ?? "")}`,
}));
---

<SectionShell data-reveal-root>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="teaser-eyebrow mb-5 text-[0.7rem] font-heading font-black uppercase tracking-[0.18em] text-muted-foreground">
        Field Notes
      </p>
      <h2 class="fs-xl leading-[1.02] text-foreground">
        From the <span class="text-accent-strong">build log.</span>
      </h2>
    </div>
    <Button href="/blog" variant="outline" size="md">All Field Notes</Button>
  </div>

  <div class="teaser-grid mt-10">
    {cards.map((card, index) => (
      <a href={card.href} class="teaser-card" data-reveal data-index={index}>
        <p class="teaser-card__label">{card.meta}</p>
        <h3 class="teaser-card__title">{card.title}</h3>
        <p class="teaser-card__body">{card.description}</p>
      </a>
    ))}
  </div>
</SectionShell>

<style>
  .teaser-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .teaser-eyebrow::before {
    content: "";
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent-strong);
    flex-shrink: 0;
  }

  .teaser-grid {
    display: grid;
    gap: 1rem;
  }

  /* Newest post leads full width; the next three sit in a row under it.
     The whole card is the link, so there is no separate "Read" control. */
  @media (min-width: 40rem) {
    .teaser-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .teaser-card[data-index="0"] {
      grid-column: 1 / -1;
      padding: 2rem;
    }

    .teaser-card[data-index="0"] .teaser-card__title {
      font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem);
      max-width: 28ch;
    }

    .teaser-card[data-index="0"] .teaser-card__body {
      -webkit-line-clamp: 3;
      max-width: 62ch;
    }
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .teaser-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .teaser-card[data-index="3"] {
      display: none;
    }
  }

  /* White slab on paper, no border, no shadow. Hover lifts nothing; the
     title takes the ember text colour, as a pressed row does in the app. */
  .teaser-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 2rem;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }

  :global(html[data-theme="dark"]) .teaser-card {
    border: 1px solid var(--border);
  }

  .teaser-card__label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .teaser-card__title {
    margin: 0.75rem 0 0;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1.2;
    text-wrap: pretty;
    color: var(--foreground);
    transition: color 150ms ease-out;
  }

  .teaser-card:hover .teaser-card__title {
    color: var(--accent-text);
  }

  .teaser-card__body {
    margin: 0.6rem 0 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stagger in CSS; inline style attributes are blocked by the site CSP */
  .teaser-card[data-index="1"] { --reveal-delay: 80ms; }
  .teaser-card[data-index="2"] { --reveal-delay: 160ms; }
  .teaser-card[data-index="3"] { --reveal-delay: 240ms; }
</style>
