---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import PillarIcon from "./ui/PillarIcon.astro";

const pillarsEntry = await getEntry("landingValuePillars", "value-pillars");

if (!pillarsEntry) {
  throw new Error("Could not find PocketChomp value pillars content");
}

const { headline, items } = pillarsEntry.data;
---

<SectionShell innerClass="space-y-12" data-reveal-root>
  <h2 class="fs-xl leading-[0.92] text-foreground">
    {headline}
  </h2>

  <!-- Icon, heading, paragraph. No card, no chips, no eyebrow: the three
       pillars are a statement, not a feature grid. -->
  <div class="pillar-grid">
    {
      items.map((item) => (
        <article class="pillar" data-reveal>
          <span class:list={["pillar__mark", `pillar__mark--${item.tone}`]}>
            <PillarIcon name={item.icon} class="pillar__icon" />
          </span>
          <h3 class="pillar__headline">{item.headline}</h3>
          <p class="pillar__body">{item.description}</p>
        </article>
      ))
    }
  </div>
</SectionShell>

<style>
  .pillar-grid {
    display: grid;
    gap: 3rem 2.5rem;
  }

  @media (min-width: 48rem) {
    .pillar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Each mark sits on a soft disc of its own hue, so the three read as a set
     of three rather than three copies of one. The icon is drawn at display
     size now that the card around it is gone. */
  .pillar__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 999px;
    color: var(--mark-ink);
    background: color-mix(in oklab, var(--mark-ink) 12%, transparent);
  }

  /* Ember for the Canadian leaf, sage for the free-forever tag, and a cooler
     blue-green for privacy so it does not read as a second sage pillar. */
  .pillar__mark--canadian {
    --mark-ink: var(--accent-strong);
  }

  .pillar__mark--free {
    --mark-ink: var(--primary);
  }

  .pillar__mark--private {
    --mark-ink: oklch(0.48 0.09 232);
  }

  :global(html[data-theme="dark"]) .pillar__mark--canadian {
    --mark-ink: var(--accent);
  }

  :global(html[data-theme="dark"]) .pillar__mark--free {
    --mark-ink: oklch(0.72 0.08 164);
  }

  :global(html[data-theme="dark"]) .pillar__mark--private {
    --mark-ink: oklch(0.7 0.1 232);
  }

  .pillar__mark :global(.pillar__icon) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .pillar__headline {
    margin: 1.5rem 0 0;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.3rem;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--foreground);
  }

  .pillar__body {
    margin: 0.85rem 0 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .pillar:nth-child(2) {
    --reveal-delay: 100ms;
  }

  .pillar:nth-child(3) {
    --reveal-delay: 200ms;
  }
</style>
