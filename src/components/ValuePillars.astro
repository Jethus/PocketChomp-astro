---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import EyebrowPill from "./ui/EyebrowPill.astro";
import ChipList from "./ui/ChipList.astro";

const pillarsEntry = await getEntry("landingValuePillars", "value-pillars");

if (!pillarsEntry) {
  throw new Error("Could not find PocketChomp value pillars content");
}

const { headline, items } = pillarsEntry.data;
---

<SectionShell innerClass="space-y-10" data-reveal-root>
  <h2 class="fs-xl leading-[0.92] text-foreground">
    {headline}
  </h2>
  <div class="grid gap-6 md:grid-cols-2">
  {
    items.map((item, index) => (
      <article class="pillar-card" data-reveal>
        <div class="pillar-card__inner">
          <div class="flex items-center gap-3">
            <EyebrowPill>{item.eyebrow}</EyebrowPill>
          </div>
          <h3 class="mt-5 max-w-[12ch] text-2xl leading-[1.1] text-foreground md:text-3xl lg:text-4xl">
            {item.headline}
          </h3>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
            {item.description}
          </p>
          <div class="mt-6">
            <ChipList items={item.chips} tone={item.tone} />
          </div>
        </div>
      </article>
    ))
  }
  </div>
</SectionShell>

<style>
  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .pillar-card:nth-child(2) {
    --reveal-delay: 100ms;
  }
  .pillar-card:nth-child(3) {
    --reveal-delay: 200ms;
  }
  .pillar-card:nth-child(4) {
    --reveal-delay: 300ms;
  }

  /* Gradient-border card */
  .pillar-card {
    position: relative;
    border-radius: 1.6rem;
    padding: 2px; /* border thickness */
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--border) 90%, var(--primary) 10%),
      color-mix(in oklab, var(--border) 40%, transparent),
      color-mix(in oklab, var(--border) 70%, var(--primary) 5%)
    );
    box-shadow: var(--shadow-elevated);
  }

  .pillar-card__inner {
    position: relative;
    border-radius: calc(1.6rem - 2px);
    background: var(--surface);
    padding: 2rem 2rem 1.75rem;
    height: 100%;
    overflow: hidden;
  }

  /* Dark mode refinements */
  :global(html[data-theme="dark"]) .pillar-card {
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--border) 100%, white 8%),
      color-mix(in oklab, var(--border) 30%, transparent),
      color-mix(in oklab, var(--border) 80%, white 4%)
    );
  }

  :global(html[data-theme="dark"]) .pillar-card__inner {
    background: color-mix(in oklab, var(--surface) 95%, black 5%);
  }
</style>
