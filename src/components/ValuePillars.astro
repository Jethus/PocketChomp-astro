---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import PillarIcon from "./ui/PillarIcon.astro";

const pillarsEntry = await getEntry("landingValuePillars", "value-pillars");

if (!pillarsEntry) {
  throw new Error("Could not find PocketChomp value pillars content");
}

const { headline, items } = pillarsEntry.data;
---

<SectionShell innerClass="space-y-10" data-reveal-root>
  <h2 class="fs-xl leading-[0.92] text-foreground">
    {headline}
  </h2>

  <!-- Icon, heading, paragraph. No card, no chips, no eyebrow: the three
       pillars are a statement, not a feature grid. -->
  <div class="pillar-grid">
    {
      items.map((item) => (
        <article class="pillar" data-reveal>
          <span class:list={["pillar__mark", `pillar__mark--${item.tone}`]}>
            <PillarIcon name={item.icon} class="pillar__icon" />
          </span>
          <h3 class="pillar__headline">{item.headline}</h3>
          <p class="pillar__body">{item.description}</p>
        </article>
      ))
    }
  </div>
</SectionShell>

<style>
  /* No boxes: three large statements under a heavy rule, numbered like a
     manifesto. The app's slab grammar made these read as settings cards. */
  .pillar-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .pillar-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .pillar {
    border-top: 2px solid var(--foreground);
    padding-top: 1.75rem;
  }

  /* The icon leads each pillar: a large disc in its own hue, icon at
     display size, so the three read at a glance before the words do. */
  .pillar__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(5.5rem, 4.6rem + 2.2vw, 7rem);
    height: clamp(5.5rem, 4.6rem + 2.2vw, 7rem);
    border-radius: 999px;
    color: var(--mark-ink);
    background: color-mix(in oklab, var(--mark-ink) 16%, transparent);
  }

  .pillar__mark--canadian { --mark-ink: var(--accent-text); }
  .pillar__mark--free { --mark-ink: var(--primary-strong); }
  .pillar__mark--private { --mark-ink: var(--color-water); }

  .pillar__mark :global(.pillar__icon) {
    width: 52%;
    height: 52%;
  }

  .pillar__headline {
    margin: 1.5rem 0 0;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1.1;
    color: var(--foreground);
  }

  .pillar__body {
    margin: 0.9rem 0 0;
    max-width: 36ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .pillar:nth-child(2) { --reveal-delay: 100ms; }
  .pillar:nth-child(3) { --reveal-delay: 200ms; }
</style>
