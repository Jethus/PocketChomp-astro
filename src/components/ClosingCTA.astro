---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import SignupForm from "./ui/SignupForm.astro";

const ctaEntry = await getEntry("landingSignupCta", "signup-cta");

if (!ctaEntry) {
  throw new Error("Could not find PocketChomp signup CTA content");
}

const { headline, description, inputPlaceholder, buttonText, note, proof, compare } = ctaEntry.data;
---

<SectionShell class="pb-10" innerClass="cta-slab-wrap" data-reveal-root>
  <div id="signup" class="cta-slab grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,36rem)]">
    <div data-reveal>
      <h2 class="fs-xl leading-[1.05] text-white">
        {headline}
      </h2>
      <p class="cta-slab__muted mt-3 max-w-xl text-lg leading-relaxed">
        {description}
      </p>
    </div>

    <div class="cta-form" data-reveal>
      <SignupForm placeholder={inputPlaceholder} buttonText={buttonText} placement="closing-cta" id="signup-form" />

      <!-- Proof sits beside the field, not at the bottom of the page: the
           doubt shows up at the button, so the answer has to be there too. -->
      <ul class="cta-proof mt-4" aria-label="What you get">
        {proof.map((item) => <li class="cta-proof__item">{item}</li>)}
      </ul>
      {compare && (
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          {compare.text}{" "}
          <a href={compare.href} class="font-semibold text-foreground underline underline-offset-4 decoration-accent hover:text-accent-strong">
            {compare.linkLabel}
          </a>
        </p>
      )}

      <p class="cta-slab__muted mt-4 text-sm leading-relaxed">{note}</p>
    </div>
  </div>
</SectionShell>

<style>
  /* The app's dark ember slab (Plan's check-in card): one strong, warm block
     to end the page on, the same in both themes. */
  .cta-slab {
    border-radius: 2rem;
    background: var(--ember-deep);
    padding: 2.5rem 1.5rem;
    color: white;
  }

  @media (min-width: 48rem) {
    .cta-slab {
      padding: 3.5rem 3rem;
    }
  }

  .cta-slab__muted {
    color: oklch(1 0 0 / 0.72);
  }

  /* The form's white field reads as a field on the dark slab. */
  .cta-slab :global(.signup-shell) {
    background: white;
    --field-bg: white;
    --field-fg: oklch(0.2992 0.0088 159.54);
  }

  .cta-slab :global(.signup-shell input) {
    background: transparent;
    color: oklch(0.2992 0.0088 159.54);
  }

  .cta-slab :global(.signup-shell input::placeholder) {
    color: oklch(0.4495 0 0);
  }

  @media (max-width: 40rem) {
    .cta-slab :global(.signup-shell) {
      background: transparent;
    }

    .cta-slab :global(.signup-shell input) {
      background: white;
      border-color: transparent;
    }
  }

  .cta-slab .cta-proof {
    color: white;
  }

  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .cta-form {
    --reveal-delay: 120ms;
  }

  /* A wrapping row of short checkable claims under the field. Each gets a
     brand-coloured check so the list reads as proof, not as more copy. */
  .cta-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: white;
  }

  .cta-proof__item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cta-proof__item::before {
    content: "\2713";
    flex: none;
    color: oklch(0.7272 0.1488 44.71); /* app dark selected-text #F28552 */
    font-weight: 900;
  }

</style>
