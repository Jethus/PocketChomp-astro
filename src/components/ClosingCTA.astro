---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import SignupForm from "./ui/SignupForm.astro";

const ctaEntry = await getEntry("landingSignupCta", "signup-cta");

if (!ctaEntry) {
  throw new Error("Could not find PocketChomp signup CTA content");
}

const { headline, description, inputPlaceholder, buttonText, note, proof, compare } = ctaEntry.data;
---

<SectionShell class="pb-10" data-reveal-root>
  <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,36rem)]">
    <div data-reveal>
      <h2 class="fs-xl leading-[1.05] text-foreground">
        {headline}
      </h2>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-muted-foreground">
        {description}
      </p>
    </div>

    <div class="cta-form" data-reveal>
      <SignupForm placeholder={inputPlaceholder} buttonText={buttonText} placement="closing-cta" />

      <!-- Proof sits beside the field, not at the bottom of the page: the
           doubt shows up at the button, so the answer has to be there too. -->
      <ul class="cta-proof mt-4" aria-label="What you get">
        {proof.map((item) => <li class="cta-proof__item">{item}</li>)}
      </ul>
      {compare && (
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          {compare.text}{" "}
          <a href={compare.href} class="font-semibold text-foreground underline underline-offset-4 decoration-accent hover:text-accent-strong">
            {compare.linkLabel}
          </a>
        </p>
      )}

      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{note}</p>
    </div>
  </div>
</SectionShell>

<style>
  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .cta-form {
    --reveal-delay: 120ms;
  }

  /* Two columns of short checkable claims under the field. Each line gets a
     brand-coloured check so the list reads as proof, not as more copy. */
  .cta-proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .cta-proof__item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cta-proof__item::before {
    content: "\2713";
    flex: none;
    color: var(--accent);
    font-weight: 900;
  }

  @media (max-width: 26rem) {
    .cta-proof {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
