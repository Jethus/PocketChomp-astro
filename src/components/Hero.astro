---
import { getEntry } from "astro:content";
import Button from "./ui/Button.astro";
import SectionShell from "./ui/SectionShell.astro";
import androidFrameDark from "../assets/png/android-frame-dark.png";
import androidFrameLight from "../assets/png/android-frame-light.png";
import uiDashboard from "../assets/ui/ui-dashboard.png";
import uiCalories from "../assets/ui/ui-calories.png";
import uiMacros from "../assets/ui/ui-macros.png";
import uiRing from "../assets/ui/ui-ring.png";
import uiSearchRow from "../assets/ui/ui-search-row.png";

const heroEntry = await getEntry("landingHero", "hero");

if (!heroEntry) {
  throw new Error("Could not find PocketChomp hero content");
}

const {
  headline,
  accent,
  description,
  primaryCtaText,
  primaryCtaLink,
  secondaryCtaText,
  secondaryCtaLink,
} = heroEntry.data;
---

<section id="hero" class="overflow-x-clip border-b border-border hero-section">
  <SectionShell
    class="hero-shell"
    innerClass="max-w-[90rem] grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12"
  >
    <div class="pt-2">
      <h1 class="fs-xxl uppercase leading-[1.05] text-foreground">
        {headline}
        <span class="block text-accent">{accent}</span>
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        {description}
      </p>

      <div class="mt-7 flex flex-wrap gap-4">
        <Button href={primaryCtaLink} variant="accent" size="lg" class="hero-cta">
          {primaryCtaText}
        </Button>
        <Button href={secondaryCtaLink} variant="outline" size="lg" class="hero-cta">
          {secondaryCtaText}
        </Button>
      </div>
    </div>

    <div class="hero-grid" aria-hidden="true" data-hero-grid>
      <article class="hero-panel hero-panel--shot hero-panel--tl" style="--reveal-delay: 80ms">
        <img src={uiCalories.src} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <article class="hero-panel hero-panel--shot hero-panel--bl" style="--reveal-delay: 220ms">
        <img src={uiMacros.src} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <div class="hero-panel hero-panel--phone hero-panel--center" style="--reveal-delay: 0ms">
        <img
          src={uiDashboard.src}
          alt="PocketChomp dashboard showing today's calories, macros and micronutrients"
          class="hero-phone__screen"
          loading="eager"
        />
        <span class="hero-phone__sheen"></span>
        <img src={androidFrameLight.src} alt="" class="hero-frame hero-frame--light" />
        <img src={androidFrameDark.src} alt="" class="hero-frame hero-frame--dark" />
      </div>

      <article class="hero-panel hero-panel--shot hero-panel--tr" style="--reveal-delay: 160ms">
        <img src={uiRing.src} alt="" class="hero-shot__img hero-shot__img--contain" loading="eager" />
      </article>

      <article class="hero-panel hero-panel--shot hero-panel--br" style="--reveal-delay: 300ms">
        <img src={uiSearchRow.src} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <article class="hero-panel hero-panel--mini hero-panel--bc" style="--reveal-delay: 380ms">
        <span class="hero-mini__dot"></span>
        <span class="hero-mini__label">on-device by default</span>
      </article>
    </div>
  </SectionShell>
</section>

<script>
  // Reveal the hero collage once it scrolls into view (or immediately if
  // already visible on load). Pure progressive enhancement — without JS the
  // panels still render, just without the staggered entrance.
  const grid = document.querySelector<HTMLElement>("[data-hero-grid]");
  if (grid) {
    const reveal = () => grid.classList.add("is-revealed");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
              obs.disconnect();
            }
          }
        },
        { threshold: 0.2 }
      );
      io.observe(grid);
    } else {
      reveal();
    }
  }
</script>

<style>
  .hero-cta {
    min-width: 12rem;
  }

  /* Grid fills its column, height derived from aspect-ratio */
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    grid-template-rows: repeat(8, 1fr);
    gap: 1.25rem;
    width: 100%;
    aspect-ratio: 1 / 1.25;
  }

  .hero-panel {
    border: 1px solid var(--border);
    border-radius: 1.6rem;
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
  }

  /* Frameless UI extracts fill their panel edge-to-edge */
  .hero-panel--shot {
    padding: 0;
    background: #16110d;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  .hero-shot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
  }

  /* The macro ring reads best fully visible, not cropped */
  .hero-shot__img--contain {
    object-fit: contain;
    object-position: center;
    padding: 0.6rem;
  }

  /* cols 1-3: left panels, cols 4-7: phone, cols 8-10: right panels */
  .hero-panel--tl {
    grid-column: 1 / span 3;
    grid-row: 1 / span 4;
  }

  .hero-panel--bl {
    grid-column: 1 / span 3;
    grid-row: 5 / span 3;
  }

  .hero-panel--center {
    position: relative;
    grid-column: 4 / span 4;
    grid-row: 1 / span 5;
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  .hero-panel--bc {
    grid-column: 4 / span 4;
    grid-row: 6 / span 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 1.6rem;
    background: color-mix(in oklab, var(--surface) 86%, transparent);
    padding-inline: 0.85rem;
  }

  .hero-panel--tr {
    grid-column: 8 / span 3;
    grid-row: 1 / span 4;
  }

  .hero-panel--br {
    grid-column: 8 / span 3;
    grid-row: 5 / span 3;
  }

  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
  }

  .hero-frame--dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-frame--light {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-frame--dark {
    display: block;
  }

  .hero-phone__screen {
    position: absolute;
    inset: 3.5% 6% 3.5% 6%;
    width: 88%;
    height: 93%;
    border-radius: 1.6rem;
    object-fit: cover;
    object-position: top;
    z-index: 1;
  }

  .hero-mini__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .hero-mini__label {
    font-family: var(--font-heading);
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  :global(html[data-theme="dark"]) .hero-panel--mini {
    background: color-mix(in oklab, var(--surface) 92%, black);
  }

  /* Shot panels keep the app's dark UI background in both themes */
  .hero-panel--shot,
  :global(html[data-theme="dark"]) .hero-panel--shot {
    background: #16110d;
  }

  :global(html[data-theme="dark"]) .hero-panel--bc {
    background: color-mix(in oklab, var(--surface) 90%, black);
  }

  /* ---- Entrance: panels rise + fade in, staggered via --reveal-delay ---- */
  .hero-panel {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }

  [data-hero-grid].is-revealed .hero-panel {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms);
  }

  /* One-shot sheen sweeping across the phone after it reveals */
  .hero-phone__sheen {
    position: absolute;
    inset: 3.5% 6% 3.5% 6%;
    border-radius: 1.6rem;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-phone__sheen::after {
    content: "";
    position: absolute;
    top: -30%;
    left: -60%;
    width: 45%;
    height: 160%;
    transform: rotate(18deg) translateX(-120%);
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, white 32%, transparent),
      transparent
    );
  }

  [data-hero-grid].is-revealed .hero-phone__sheen::after {
    animation: hero-sheen 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.55s 1 both;
  }

  @keyframes hero-sheen {
    from {
      transform: rotate(18deg) translateX(-120%);
    }
    to {
      transform: rotate(18deg) translateX(420%);
    }
  }

  .hero-mini__dot {
    animation: hero-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--primary) 55%, transparent);
    }
    50% {
      box-shadow: 0 0 0 0.32rem color-mix(in oklab, var(--primary) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-panel {
      opacity: 1;
      transform: none;
    }
    .hero-phone__sheen::after,
    [data-hero-grid].is-revealed .hero-phone__sheen::after,
    .hero-mini__dot {
      animation: none;
    }
  }

  /* Below lg: grid goes full width, stack is centered, cap to readable size */
  @media (max-width: 64rem) {
    .hero-grid {
      max-width: 36rem;
      margin-inline: auto;
    }
  }
</style>
