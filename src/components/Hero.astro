---
import { getEntry } from "astro:content";
import { getImage } from "astro:assets";
import Button from "./ui/Button.astro";
import SectionShell from "./ui/SectionShell.astro";
import androidFrameDark from "../assets/png/android-frame-dark.png";
import androidFrameLight from "../assets/png/android-frame-light.png";
import uiDashboard from "../assets/screens/screen-home.png";
import uiScreenLabel from "../assets/screens/screen-diary.png";
import uiScreenSearch from "../assets/screens/screen-search.png";

// The source captures are full-resolution phone screenshots. Emit sized
// WebP renditions so the hero does not ship 300 KB PNGs; the largest panel
// renders well under 640 CSS px even on wide screens.
const [shotLabel, shotSearch, shotDashboard, frameLight, frameDark] = await Promise.all([
  getImage({ src: uiScreenLabel, width: 480, format: "webp" }),
  getImage({ src: uiScreenSearch, width: 480, format: "webp" }),
  getImage({ src: uiDashboard, width: 640, format: "webp" }),
  getImage({ src: androidFrameLight, width: 640, format: "webp" }),
  getImage({ src: androidFrameDark, width: 640, format: "webp" }),
]);

const heroEntry = await getEntry("landingHero", "hero");

if (!heroEntry) {
  throw new Error("Could not find PocketChomp hero content");
}

const {
  headline,
  accents,
  description,
  primaryCtaText,
  primaryCtaLink,
  secondaryCtaText,
  secondaryCtaLink,
  ctaNote,
  collageCards,
} = heroEntry.data;

const ringCard = collageCards.find((card) => card.kind === "ring");
const dbCard = collageCards.find((card) => card.kind === "database");
---

<section id="hero" class="overflow-x-clip border-b border-border hero-section">
  <SectionShell
    class="hero-shell"
    innerClass="max-w-[90rem] grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12"
  >
    <div class="pt-2">
      <h1 class="fs-xxl uppercase leading-[1.05] text-foreground">
        {headline}
        <span class="hero-accent-stack">
          {accents.map((word) => (
            <span class="hero-accent-ghost" aria-hidden="true">{word}</span>
          ))}
          <span
            class="hero-accent is-punchline"
            data-accent-rotator
            data-words={JSON.stringify(accents)}
          >{accents[accents.length - 1]}</span>
        </span>
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        {description}
      </p>

      <div class="mt-7 flex flex-wrap gap-4">
        <Button href={primaryCtaLink} variant="accent" size="lg" class="hero-cta">
          {primaryCtaText}
        </Button>
        <Button href={secondaryCtaLink} variant="outline" size="lg" class="hero-cta">
          {secondaryCtaText}
        </Button>
      </div>

      <p class="mt-4 text-sm font-medium tracking-wide text-muted-foreground">
        {ctaNote}
      </p>
    </div>

    <div class="hero-grid" aria-hidden="true" data-reveal-root>
      <article class="hero-panel hero-panel--shot hero-panel--tl" data-reveal>
        <img src={shotLabel.src} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <article class="hero-panel hero-panel--shot hero-panel--bl" data-reveal>
        <img src={shotSearch.src} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <div class="hero-panel hero-panel--phone hero-panel--center" data-reveal>
        <img
          src={shotDashboard.src}
          alt="PocketChomp dashboard showing today's calories, macros and micronutrients"
          class="hero-phone__screen"
          loading="eager"
        />
        <span class="hero-phone__sheen"></span>
        <img src={frameLight.src} alt="" class="hero-frame hero-frame--light" />
        <img src={frameDark.src} alt="" class="hero-frame hero-frame--dark" />
      </div>

      <article class="hero-panel hero-panel--tile hero-panel--tr" data-reveal>
        {ringCard && (
          <>
            <span class="hero-tile__badge">
              <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
                <circle cx="18" cy="18" r="12" stroke="var(--accent)" stroke-width="5.5" stroke-dasharray="47 76" stroke-linecap="round" transform="rotate(-90 18 18)" />
                <circle cx="18" cy="18" r="12" stroke="var(--primary)" stroke-width="5.5" stroke-dasharray="20 76" stroke-dashoffset="-51" stroke-linecap="round" transform="rotate(-90 18 18)" />
              </svg>
            </span>
            <span class="hero-tile__label">{ringCard.title}</span>
          </>
        )}
      </article>

      <article class="hero-panel hero-panel--tile hero-panel--br" data-reveal>
        {dbCard && (
          <>
            <span class="hero-tile__badge">
              <svg viewBox="0 0 36 36" fill="none" stroke="var(--primary)" stroke-width="2.4" aria-hidden="true">
                <ellipse cx="18" cy="10" rx="10" ry="4.5" />
                <path d="M8 10v8c0 2.5 4.5 4.5 10 4.5s10-2 10-4.5v-8" />
                <path d="M8 18v8c0 2.5 4.5 4.5 10 4.5s10-2 10-4.5v-8" />
              </svg>
            </span>
            {dbCard.body && <span class="hero-tile__eyebrow">{dbCard.body}</span>}
            <span class="hero-tile__label">{dbCard.title}</span>
          </>
        )}
      </article>

      <article class="hero-panel hero-panel--mini hero-panel--bc" data-reveal>
        <span class="hero-mini__pill">
          <span class="hero-mini__dot"></span>
          <span class="hero-mini__label">on-device by default</span>
        </span>
      </article>
    </div>
  </SectionShell>
</section>

<script>
  const rotator = document.querySelector<HTMLElement>("[data-accent-rotator]");

  if (rotator) {
    const words: string[] = JSON.parse(rotator.dataset.words ?? "[]");

    if (words.length > 1) {
      const HOLD = 2200;
      const HOLD_PUNCHLINE = 3600;
      const SWAP = 230;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let next = 0;

      const show = () => {
        const isPunchline = next === words.length - 1;
        rotator.textContent = words[next];
        rotator.classList.remove("is-swapping");
        rotator.classList.toggle("is-punchline", isPunchline);
        next = (next + 1) % words.length;
        setTimeout(swap, isPunchline ? HOLD_PUNCHLINE : HOLD);
      };

      const swap = () => {
        if (reduceMotion.matches) {
          // Reduced motion: still rotate, but hard-cut — no fade/translate
          show();
        } else {
          rotator.classList.add("is-swapping");
          setTimeout(show, SWAP);
        }
      };

      // Punchline is rendered statically, so open on its long hold
      setTimeout(swap, HOLD_PUNCHLINE);
    }
  }
</script>

<style>
  .hero-cta {
    min-width: 12rem;
  }

  /* Grid fills its column, height derived from aspect-ratio */
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    grid-template-rows: repeat(8, 1fr);
    gap: 1.25rem;
    width: 100%;
    aspect-ratio: 1 / 1.25;
  }

  /* Reveal stagger lives in CSS — CSP (style-src, no unsafe-inline) blocks
     inline style attributes site-wide, so never pass --reveal-delay inline */
  .hero-panel--tl {
    --reveal-delay: 80ms;
  }
  .hero-panel--bl {
    --reveal-delay: 220ms;
  }
  .hero-panel--tr {
    --reveal-delay: 160ms;
  }
  .hero-panel--br {
    --reveal-delay: 300ms;
  }
  .hero-panel--bc {
    --reveal-delay: 380ms;
  }

  .hero-panel {
    border: 1px solid var(--border);
    border-radius: 1.6rem;
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
  }

  /* Frameless UI extracts fill their panel edge-to-edge */
  .hero-panel--shot {
    padding: 0;
    background: #16110d;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  /* Full app screens fill the portrait panels nearly edge-to-edge —
     top-anchored so each panel opens on a complete piece of UI */
  .hero-shot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* All words stack in one grid cell: hidden ghosts reserve the size of
     the longest word so swaps never shift layout */
  .hero-accent-stack {
    display: grid;
  }

  .hero-accent-stack > * {
    grid-area: 1 / 1;
  }

  .hero-accent-ghost {
    visibility: hidden;
  }

  /* Headline accent follows the brand mockup: green on light, orange on dark;
     the punchline word flips to the opposite brand colour so it lands */
  .hero-accent {
    color: var(--primary);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .hero-accent.is-punchline {
    color: var(--accent);
  }

  .hero-accent.is-swapping {
    opacity: 0;
    transform: translateY(0.18em);
  }

  :global(html[data-theme="dark"]) .hero-accent {
    color: var(--accent);
  }

  :global(html[data-theme="dark"]) .hero-accent.is-punchline {
    color: var(--primary-strong);
  }

  /* Forest-green info tiles from the original mockup */
  .hero-panel--tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.4rem;
    text-align: center;
    background: var(--primary);
    border-color: color-mix(in oklab, var(--primary) 78%, black);
  }

  .hero-tile__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 999px;
    background: oklch(0.97 0.005 145);
    box-shadow: var(--shadow-elevated);
  }

  .hero-tile__badge svg {
    width: 2rem;
    height: 2rem;
  }

  .hero-tile__eyebrow {
    font-family: var(--font-heading);
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: oklch(0.97 0.005 145 / 0.72);
  }

  .hero-tile__label {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.25;
    max-width: 11ch;
    color: oklch(0.97 0.005 145);
  }

  /* cols 1-3: left panels, cols 4-7: phone, cols 8-10: right panels */
  .hero-panel--tl {
    grid-column: 1 / span 3;
    grid-row: 1 / span 4;
  }

  .hero-panel--bl {
    grid-column: 1 / span 3;
    grid-row: 5 / span 3;
  }

  .hero-panel--center {
    position: relative;
    grid-column: 4 / span 4;
    grid-row: 1 / span 5;
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  /* The status pill floats in its grid cell — the cell itself is invisible */
  .hero-panel--bc {
    grid-column: 4 / span 4;
    grid-row: 6 / span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    box-shadow: none;
    overflow: visible;
  }

  .hero-mini__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
    padding: 0.55rem 1rem;
  }

  .hero-panel--tr {
    grid-column: 8 / span 3;
    grid-row: 1 / span 4;
  }

  .hero-panel--br {
    grid-column: 8 / span 3;
    grid-row: 5 / span 3;
  }

  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
  }

  .hero-frame--dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-frame--light {
    display: none;
  }

  :global(html[data-theme="dark"]) .hero-frame--dark {
    display: block;
  }

  .hero-phone__screen {
    position: absolute;
    inset: 3.5% 6% 3.5% 6%;
    width: 88%;
    height: 93%;
    border-radius: 1.6rem;
    object-fit: cover;
    object-position: top;
    z-index: 1;
  }

  .hero-mini__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .hero-mini__label {
    font-family: var(--font-heading);
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  /* Screenshots are light-theme, so the shot panels keep a light bed in
     both themes; a dark surface behind them would halo */
  .hero-panel--shot,
  :global(html[data-theme="dark"]) .hero-panel--shot {
    background: oklch(0.97 0.005 145);
  }

  /* One-shot sheen sweeping across the phone after it reveals */
  .hero-phone__sheen {
    position: absolute;
    inset: 3.5% 6% 3.5% 6%;
    border-radius: 1.6rem;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-phone__sheen::after {
    content: "";
    position: absolute;
    top: -30%;
    left: -60%;
    width: 45%;
    height: 160%;
    transform: rotate(18deg) translateX(-120%);
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, white 32%, transparent),
      transparent
    );
  }

  [data-reveal-root].is-revealed .hero-phone__sheen::after {
    animation: hero-sheen 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.55s 1 both;
  }

  @keyframes hero-sheen {
    from {
      transform: rotate(18deg) translateX(-120%);
    }
    to {
      transform: rotate(18deg) translateX(420%);
    }
  }

  .hero-mini__dot {
    animation: hero-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--primary) 55%, transparent);
    }
    50% {
      box-shadow: 0 0 0 0.32rem color-mix(in oklab, var(--primary) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-phone__sheen::after,
    [data-reveal-root].is-revealed .hero-phone__sheen::after,
    .hero-mini__dot {
      animation: none;
    }
  }

  /* Below lg: grid goes full width, stack is centered, cap to readable size */
  @media (max-width: 64rem) {
    .hero-grid {
      max-width: 36rem;
      margin-inline: auto;
    }
  }
</style>
