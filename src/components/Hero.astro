---
import { getEntry } from "astro:content";
import { getImage } from "astro:assets";
import Button from "./ui/Button.astro";
import PlayBadge from "./ui/PlayBadge.astro";
import SectionShell from "./ui/SectionShell.astro";
import uiDashboard from "../assets/screens/screen-diary.webp";
import uiSearchCrop from "../assets/ui/hero-search.webp";
import uiPlanCrop from "../assets/ui/hero-week.webp";
import uiMetricsCrop from "../assets/ui/hero-plate.webp";

// The plate (capture already inside the Pixel 8 Pro skin) and the UI
// extracts are full-resolution, built by scripts/build-screens.mjs. Emit a
// srcset of WebP renditions (quality 85 keeps UI text crisp) that tops out at
// the source's own width, so a high-density screen never upscales them.
const [shotSearch, shotPlan, shotMetrics, shotDashboard] = await Promise.all([
  getImage({ src: uiSearchCrop, widths: [640, 960, 1344], format: "webp", quality: 85 }),
  getImage({ src: uiPlanCrop, widths: [640, 960, 1344], format: "webp", quality: 85 }),
  getImage({ src: uiMetricsCrop, widths: [640, 960, 1344], format: "webp", quality: 85 }),
  getImage({ src: uiDashboard, widths: [640, 1000, 1469], format: "webp", quality: 85 }),
]);
const shotSizes = "(max-width: 64rem) 50vw, 40rem";
const phoneSizes = "(max-width: 40rem) 20rem, 22rem";

const heroEntry = await getEntry("landingHero", "hero");

if (!heroEntry) {
  throw new Error("Could not find PocketChomp hero content");
}

const {
  headline,
  accents,
  description,
  secondaryCtaText,
  secondaryCtaLink,
  ctaNote,
} = heroEntry.data;

// The rotating line reserves the width of its longest word through a CSS
// ::before (see .hero-accent-stack) rather than hidden duplicate spans, so the
// H1 text crawlers and screen readers get is the one static sentence below.
const longestAccent = accents.reduce((a, b) => (b.text.length > a.text.length ? b : a)).text;
---

<section id="hero" class="overflow-x-clip hero-section">
  <SectionShell
    class="hero-shell"
    innerClass="max-w-[90rem] grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12"
  >
    <div class="pt-2">
      <h1 class="fs-xxl uppercase leading-[1.05] text-foreground">
        {headline}{" "}
        <span class="hero-accent-stack" data-longest={longestAccent}>
          <span
            class="hero-accent"
            data-accent-rotator
            data-tint={accents[accents.length - 1].tint}
            data-words={JSON.stringify(accents)}
          >{accents[accents.length - 1].text}</span>
        </span>
      </h1>

      <p class="hero-lede mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        {description}
      </p>

      <div class="hero-ctas mt-7 flex flex-wrap items-center gap-4">
        <PlayBadge />
        <Button href={secondaryCtaLink} variant="outline" size="lg" class="hero-cta hero-cta--secondary">
          {secondaryCtaText}
        </Button>
      </div>

      <p class="mt-4 text-sm font-medium tracking-wide text-muted-foreground">
        {ctaNote}
      </p>
    </div>

    <div class="hero-grid" aria-hidden="true" data-reveal-root>
      <article class="hero-panel hero-panel--shot hero-panel--tl" data-reveal>
        <img src={shotSearch.src} srcset={shotSearch.srcSet.attribute} sizes={shotSizes} width={shotSearch.attributes.width} height={shotSearch.attributes.height} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <article class="hero-panel hero-panel--shot hero-panel--bl" data-reveal>
        <img src={shotMetrics.src} srcset={shotMetrics.srcSet.attribute} sizes={shotSizes} width={shotMetrics.attributes.width} height={shotMetrics.attributes.height} alt="" class="hero-shot__img" loading="eager" />
      </article>

      <div class="hero-panel hero-panel--phone hero-panel--center" data-reveal>
        <img
          src={shotDashboard.src}
          srcset={shotDashboard.srcSet.attribute}
          sizes={phoneSizes}
          width={shotDashboard.attributes.width}
          height={shotDashboard.attributes.height}
          alt="PocketChomp diary showing today's calories, protein, carbs, fat and fibre, four micronutrients, and water"
          class="hero-phone__screen"
          loading="eager"
        />
        <span class="hero-phone__sheen"></span>
      </div>

      <article class="hero-panel hero-panel--shot hero-panel--tr" data-reveal>
        <img src={shotPlan.src} srcset={shotPlan.srcSet.attribute} sizes={shotSizes} width={shotPlan.attributes.width} height={shotPlan.attributes.height} alt="" class="hero-shot__img" loading="eager" />
      </article>
    </div>
  </SectionShell>
</section>

<script>
  const rotator = document.querySelector<HTMLElement>("[data-accent-rotator]");

  if (rotator) {
    const words: { text: string; tint: string }[] = JSON.parse(rotator.dataset.words ?? "[]");

    if (words.length > 1) {
      // Short holds on purpose: the rotating goals are two words and read at
      // a glance, so a long dwell reads as a stall rather than a list. SWAP
      // matches the CSS transition and stays well under HOLD.
      const HOLD = 1200;
      const HOLD_PUNCHLINE = 2000;
      const SWAP = 200;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let next = 0;

      const show = () => {
        const isPunchline = next === words.length - 1;
        rotator.textContent = words[next].text;
        rotator.dataset.tint = words[next].tint;
        // Jump to the left, unanimated, then let the transition carry it in
        rotator.classList.remove("is-swapping");
        rotator.classList.add("is-entering");
        void rotator.offsetWidth;
        rotator.classList.remove("is-entering");
        next = (next + 1) % words.length;
        setTimeout(swap, isPunchline ? HOLD_PUNCHLINE : HOLD);
      };

      const swap = () => {
        if (reduceMotion.matches) {
          // Reduced motion: still rotate, but hard-cut — no fade/translate
          show();
        } else {
          rotator.classList.add("is-swapping");
          setTimeout(show, SWAP);
        }
      };

      // Punchline is rendered statically, so open on its long hold
      setTimeout(swap, HOLD_PUNCHLINE);
    }
  }
</script>

<style>
  .hero-ctas :global(.hero-cta) {
    min-width: 12rem;
  }

  /* Phones: one obvious action. The Play badge leads; the secondary drops
     its outline and sits under it as a plain link, left-aligned with the
     badge, so the pair no longer reads as two mismatched pills. */
  @media (max-width: 40rem) {
    .hero-ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .hero-ctas :global(.hero-cta--secondary) {
      min-width: 0;
      padding-inline: 0;
      border-color: transparent;
      background: transparent;
      height: 3rem;
      text-decoration: underline;
      text-underline-offset: 0.3em;
      text-decoration-thickness: 1px;
    }
  }

  /* Grid fills its column, height derived from aspect-ratio */
  /* Three rows, weighted so each right-hand panel's inner box has the exact
     ratio of the UI extract it holds (search 1344x1055, plate 1344x508,
     week 1344x1045). Worked at a 640px column with the 1rem gap and 0.55rem
     panel padding; other widths drift by a percent or two, which `cover`
     absorbs at the extract's padding rather than its content. */
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    grid-template-rows: 1.915fr 1fr 1.9fr;
    gap: 1rem;
    width: 100%;
    /* Sized so the phone column (5 of 10 cols) fits a whole device at the
       plate's 1469:3104 ratio without clipping. */
    aspect-ratio: 1 / 1.03;
  }

  /* Reveal stagger lives in CSS — CSP (style-src, no unsafe-inline) blocks
     inline style attributes site-wide, so never pass --reveal-delay inline */
  .hero-panel--tl {
    --reveal-delay: 80ms;
  }
  .hero-panel--bl {
    --reveal-delay: 220ms;
  }
  .hero-panel--tr {
    --reveal-delay: 160ms;
  }

  .hero-panel {
    border: 1px solid var(--border);
    border-radius: 1.6rem;
    background: var(--surface);
    overflow: hidden;
    /* Own layers for good: when the reveal ended they were flattened and
       re-rastered on the first scroll, a ~50ms hitch. */
    will-change: transform;
  }

  /* Frameless UI extracts fill their panel edge-to-edge */
  /* Framed like a device, not presented as a flat rectangle: beside a phone in
     a real frame, a bare screenshot reads as a mistake. The inner radius and
     bezel echo the frame art without needing a second frame asset. */
  .hero-panel--shot {
    padding: 0.55rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 1.9rem;
  }

  .hero-panel--shot .hero-shot__img {
    border-radius: 1.4rem;
  }

  /* The extracts are pre-cropped to their panel's ratio (scripts/build-screens.mjs),
     so `cover` only ever trims a sliver of padding as the column width drifts.
     The search extract anchors to the top so the typed query never loses its
     box; the other two are symmetric and centre. */
  .hero-shot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-panel--tl .hero-shot__img {
    object-position: top center;
  }

  /* The rotator and an invisible copy of the longest word share one grid
     cell, so swaps never shift layout. The copy is CSS-generated content, not
     DOM text, so it never reaches the accessible name or a crawler's H1. */
  .hero-accent-stack {
    display: grid;
  }

  .hero-lede {
    text-wrap: pretty;
  }

  .hero-accent-stack > *,
  .hero-accent-stack::before {
    grid-area: 1 / 1;
  }

  .hero-accent-stack::before {
    content: attr(data-longest);
    visibility: hidden;
  }

  /* Each goal carries the colour the app gives it (macro palette, water,
     brand); the punchline lands on ember */
  .hero-accent {
    color: var(--primary);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .hero-accent[data-tint="protein"] { color: var(--color-protein); }
  .hero-accent[data-tint="carb"] { color: var(--color-carb); }
  .hero-accent[data-tint="fat"] { color: var(--color-fat); }
  /* The app's water blue is 2.5:1 on light paper, too faint for a headline
     word, and the app has no text-strength water. Same hue, deeper, for
     display type in light mode only (4.0:1). Dark mode uses the app value. */
  .hero-accent[data-tint="water"] { color: oklch(0.5604 0.0767 242.3); }
  :global(html[data-theme="dark"]) .hero-accent[data-tint="water"] { color: var(--color-water); }
  .hero-accent[data-tint="calories"] { color: var(--color-calories); }
  .hero-accent[data-tint="sage"] { color: var(--primary); }
  .hero-accent[data-tint="ember"] { color: var(--accent); }

  /* Out to the right, in from the left */
  .hero-accent.is-swapping {
    opacity: 0;
    transform: translateX(0.35em);
  }

  .hero-accent.is-entering {
    opacity: 0;
    transform: translateX(-0.35em);
    transition: none;
  }

  :global(html[data-theme="dark"]) .hero-accent[data-tint="sage"] {
    color: var(--primary-strong);
  }

  /* The protein red and the calories ember are tuned for bars on the app's
     dark surfaces; as display type on near-black they go muddy, so lift them */
  :global(html[data-theme="dark"]) .hero-accent[data-tint="protein"] {
    color: oklch(0.6690 0.1726 26.11); /* app dark protein-text #EC625A */
  }

  :global(html[data-theme="dark"]) .hero-accent[data-tint="calories"] {
    color: var(--accent);
  }

  /* Composition: the phone is the subject and gets half the width. Three UI
     extracts stack beside it — search results, the plate sheet, and the
     Insights week chart. All free-tier screens; Plus lives on /plus. Full screenshots at this size were
     unreadable; an extract shows one real piece of UI at a legible scale. */
  .hero-panel--tl {
    grid-column: 6 / span 5;
    grid-row: 1;
  }

  .hero-panel--bl {
    grid-column: 6 / span 5;
    grid-row: 2;
  }

  .hero-panel--tr {
    grid-column: 6 / span 5;
    grid-row: 3;
  }

  /* The cell keeps the plate's own aspect ratio so the sheen's percentage
     insets land on the screen. It sits at the top of its cell and takes its
     height from the artwork. */
  .hero-panel--center {
    position: relative;
    grid-column: 1 / span 5;
    grid-row: 1 / span 3;
    align-self: stretch;
    justify-self: center;
    /* Exactly the plate's own ratio (1469x3104). Height-driven so the device
       always fits its rows and never clips against the section edge; the
       column is wider than the phone and simply centres it. */
    aspect-ratio: 1469 / 3104;
    height: 100%;
    width: auto;
    max-width: 100%;
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  /* The plate is the whole device (scripts/build-screens.mjs); its box is the
     cell, which is sized to the plate's own ratio below. */
  .hero-phone__screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
  }

  /* The captures are light-theme, so the shot panels keep the app's own page
     background (sampled from the captures) in both themes; anything else
     halos around the extract */
  .hero-panel--shot,
  :global(html[data-theme="dark"]) .hero-panel--shot {
    background: #ecefec;
  }

  /* On light paper that fill is the page's own colour and the app hairline
     (#E8EDE9) vanishes, so the panels' only edge is a firmer one (#CDD2CE).
     Dark mode keeps the hairline; a light panel already stands off near-black. */
  .hero-panel--shot {
    border-color: color-mix(in oklab, var(--foreground) 16%, var(--background));
  }

  :global(html[data-theme="dark"]) .hero-panel--shot {
    border-color: var(--border);
  }

  /* One-shot sheen sweeping across the phone after it reveals */
  /* Inset to the plate's screen: 1344x2992 at (58,58) on a 1469x3104 plate */
  .hero-phone__sheen {
    position: absolute;
    inset: 1.9% 4.6% 1.7% 3.9%;
    border-radius: 2.5rem;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-phone__sheen::after {
    content: "";
    position: absolute;
    top: -30%;
    left: -60%;
    width: 45%;
    height: 160%;
    transform: rotate(18deg) translateX(-120%);
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, white 32%, transparent),
      transparent
    );
  }

  [data-reveal-root].is-revealed .hero-phone__sheen::after {
    animation: hero-sheen 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.55s 1 both;
  }

  @keyframes hero-sheen {
    from {
      transform: rotate(18deg) translateX(-120%);
    }
    to {
      transform: rotate(18deg) translateX(420%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-phone__sheen::after,
    [data-reveal-root].is-revealed .hero-phone__sheen::after {
      animation: none;
    }
  }

  /* Below lg: grid goes full width, stack is centered, cap to readable size */
  @media (max-width: 64rem) {
    .hero-grid {
      max-width: 36rem;
      margin-inline: auto;
    }
  }

  /* On a phone the two-up collage shrinks every element below legibility —
     the device ends up ~143px wide and the tile text overflows its card. One
     readable screenshot beats four unreadable ones, so the supporting panels
     step aside and the phone takes the full width. */
  @media (max-width: 40rem) {
    .hero-grid {
      position: relative;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      aspect-ratio: auto;
      max-width: 20rem;
      gap: 1.25rem;
    }

    .hero-panel--center {
      grid-column: 1;
      grid-row: auto;
      width: 100%;
      height: auto;
      justify-self: stretch;
    }

    .hero-panel--tl,
    .hero-panel--bl,
    .hero-panel--tr {
      display: none;
    }
  }
</style>
