---
import { getEntry } from "astro:content";
import logoDark from "../assets/svgs/logo-dark.svg";

const footerEntry = await getEntry("landingFooter", "footer");

if (!footerEntry) {
  throw new Error("Could not find PocketChomp footer content");
}

const { tagline, groups } = footerEntry.data;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="PocketChomp home" class="inline-flex items-center">
        <img src={logoDark.src} width={logoDark.width} height={logoDark.height} alt="PocketChomp" class="h-12 w-auto sm:h-14" />
      </a>

      <p class="footer-tagline">{tagline}</p>
      <p class="footer-platform">Android · free barcode scanning · no ads</p>
    </div>

    <nav aria-label="Footer" class="footer-nav">
      {
        groups.map((group) => (
          <div class="footer-col">
            <h2 class="footer-col__heading">{group.heading}</h2>
            <ul class="footer-col__list">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="footer-legal">
    <p>&copy; {currentYear} PocketChomp. All rights reserved.</p>
  </div>
</footer>

<style>
  /* The footer is the one full-bleed brand moment on the page. Sage ground,
     white type. Built on --primary-strong rather than --primary because white
     sits at 7.85:1 on it (vs 5.62:1), which leaves room for the muted tiers
     below to stay above AA. */
  .site-footer {
    --footer-ground: var(--primary-strong);
    --footer-text: oklch(1 0 0);
    --footer-text-muted: color-mix(in oklab, oklch(1 0 0) 80%, var(--footer-ground));
    --footer-text-faint: color-mix(in oklab, oklch(1 0 0) 70%, var(--footer-ground));
    --footer-rule: color-mix(in oklab, oklch(1 0 0) 22%, transparent);

    background: var(--footer-ground);
    color: var(--footer-text);
  }

  /* Dark theme: --primary-strong lightens to 0.58, which would put white text
     under AA. Hold the darker ground so the footer keeps the same contrast in
     both themes. */
  :global(html[data-theme="dark"]) .site-footer {
    --footer-ground: oklch(0.36 0.055 164);
  }

  .footer-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 2.5rem;
    display: grid;
    gap: 2.5rem;
  }

  /* Brand block anchors the left, link columns fill the rest — the shape most
     product sites settle on because it keeps the wordmark as the entry point
     and lets the columns stay narrow enough to scan. */
  @media (min-width: 52rem) {
    .footer-inner {
      grid-template-columns: minmax(14rem, 1fr) 2.2fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .footer-brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  /* One line: the 22ch measure was wrapping it after "Canadian," which broke
     the symmetry of the phrase. */
  .footer-tagline {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--footer-text-muted);
    white-space: nowrap;
  }

  .footer-platform {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--footer-text-faint);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  /* auto-fit rather than a fixed count, so adding or removing a group doesn't
     leave a gap in the row. */
  @media (min-width: 40rem) {
    .footer-nav {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
  }

  .footer-col__heading {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.74rem;
    color: var(--footer-text);
  }

  .footer-col__list {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  /* Each link is its own tap target: 44px tall, padded past the text so the
     whole row is clickable rather than just the glyphs. The negative inline
     margin keeps the text flush with the column heading above it. */
  .footer-col__list a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--footer-text-muted);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .footer-col__list a:hover,
  .footer-col__list a:focus-visible {
    color: var(--footer-text);
    background: color-mix(in oklab, oklch(1 0 0) 12%, transparent);
  }

  .footer-col__list a:focus-visible {
    outline: 2px solid var(--footer-text);
    outline-offset: 2px;
  }

  .footer-legal {
    border-top: 1px solid var(--footer-rule);
  }

  .footer-legal p {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 1.35rem;
    font-size: 0.85rem;
    color: var(--footer-text-faint);
  }

</style>
