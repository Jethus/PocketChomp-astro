---
/**
 * Button primitive for marketing CTAs.
 *
 * Supported variants:
 * - solid
 * - outline
 * - ghost
 *
 * Legacy aliases:
 * - primary -> solid
 * - secondary -> outline
 */
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  variant?: "solid" | "outline" | "ghost" | "accent" | "primary" | "secondary";
  size?: "sm" | "md" | "lg" | "base";
  class?: string;
}

const {
  href,
  variant = "solid",
  size = "md",
  class: className = "",
  ...rest
} = Astro.props as Props;

const normalizedVariant =
  variant === "primary" ? "solid" : variant === "secondary" ? "outline" : (variant ?? "solid");

const normalizedSize = size === "base" ? "md" : size;

/**
 * Hover language: buttons stay put and gain depth instead of moving. A lift
 * was the odd one out next to the rest of the site's hovers, which grow or
 * fade in place. Filled variants bloom their shadow and lighten a touch; the
 * flat variants, which have no resting shadow to grow, just take their fill.
 */
const variants = {
  solid:
    "border-transparent bg-primary text-primary-foreground hover:bg-primary-dark",
  outline:
    "border-2 border-foreground bg-transparent text-foreground hover:bg-surface",
  ghost:
    "border-transparent bg-transparent text-foreground hover:bg-surface",
  accent:
    "border-transparent bg-accent-strong text-accent-foreground hover:bg-accent-hover",
} as const;

const sizes = {
  sm: "h-10 px-4 text-[0.8rem]",
  md: "h-11 px-5 text-[0.86rem]",
  lg: "h-14 px-8 text-[1rem]",
} as const;

const rel = rest.target === "_blank"
  ? [rest.rel, "noopener", "noreferrer"].filter(Boolean).join(" ")
  : rest.rel;
---

<a
  href={href}
  {...rest}
  rel={rel}
  class:list={[
    "inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-full border font-body font-bold transition-[background-color,color,border-color] duration-200 ease-out active:opacity-75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 focus-visible:ring-offset-2 focus-visible:ring-offset-background",
    variants[normalizedVariant],
    sizes[normalizedSize],
    className,
  ]}
>
  <slot />
</a>
