---
interface Props extends astroHTML.JSX.HTMLAttributes {
  as?: "section" | "div" | "article";
  innerClass?: string;
}

const {
  as: Tag = "section",
  innerClass = "",
  class: className = "",
  ...rest
} = Astro.props as Props;

// A page's own max-w-* must replace the default, not sit beside it: Tailwind
// emits max-w-7xl after max-w-3xl/4xl, so the wide default always won.
const width = /(^|\s)max-w-/.test(innerClass) ? "" : "max-w-7xl";
---

<Tag {...rest} class:list={["py-16 sm:py-20 lg:py-24", className]}>
  <div class:list={["mx-auto w-full px-6", width, innerClass]}>
    <slot />
  </div>
</Tag>
