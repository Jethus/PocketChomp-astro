---
/**
 * One FAQ treatment for the whole site: flat rows with a round toggle, native
 * <details> so it works with no JS, is keyboard operable and is announced
 * correctly. The homepage, the calculators and the comparison pages all
 * render their questions through this so they stop drifting apart.
 *
 * Editorial, not app UI: full-width rules between rows, the question as the
 * loud element, and the brand orange concentrated in one place, the toggle,
 * which fills ember when its row is open.
 */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}

const { items, class: className = "" } = Astro.props as Props;
---

<div class:list={["faq-list", className]}>
  {
    items.map((item) => (
      <details class="faq-item" data-reveal>
        <summary class="faq-item__q">
          <span class="faq-item__text">{item.q}</span>
          <span class="faq-item__toggle" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </summary>
        <div class="faq-item__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 2px solid var(--foreground);
  }

  .faq-item {
    border-bottom: 1px solid color-mix(in oklab, var(--foreground) 16%, transparent);
  }

  /* The whole row is the target: 64px+ tall, question left, toggle right. */
  .faq-item__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__text {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.35rem);
    line-height: 1.25;
    color: var(--foreground);
    text-wrap: pretty;
    transition: color 150ms ease-out;
  }

  /* Round toggle: outlined at rest, fills ember on hover-intent and when
     open, and the plus turns into a cross. */
  .faq-item__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, var(--foreground) 22%, transparent);
    color: var(--foreground);
    transition:
      background-color 180ms ease-out,
      border-color 180ms ease-out,
      color 180ms ease-out;
  }

  .faq-item__toggle svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .faq-item__q:hover .faq-item__text {
      color: var(--accent-text);
    }

    .faq-item__q:hover .faq-item__toggle {
      border-color: var(--accent-strong);
      color: var(--accent-text);
    }
  }

  .faq-item[open] .faq-item__text {
    color: var(--accent-text);
  }

  .faq-item[open] .faq-item__toggle {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: var(--accent-foreground);
  }

  .faq-item[open] .faq-item__toggle svg {
    transform: rotate(45deg);
  }

  /* Keyboard focus rings the toggle, where the eye already is. */
  .faq-item__q:focus-visible {
    outline: none;
  }

  .faq-item__q:focus-visible .faq-item__toggle {
    box-shadow:
      0 0 0 3px var(--background),
      0 0 0 5px var(--accent-strong);
  }

  .faq-item__q:focus-visible .faq-item__text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .faq-item__a {
    padding: 0 4rem 1.75rem 0;
  }

  .faq-item__a p {
    margin: 0;
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  @media (max-width: 40rem) {
    .faq-item__a {
      padding-right: 0;
    }

    .faq-item__toggle {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item__toggle,
    .faq-item__toggle svg,
    .faq-item__text {
      transition: none;
    }
  }
</style>
