---
import { SIGNUP_FORM_ACTION, SIGNUP_FORM_METHOD } from "../../consts";

interface Props {
  placeholder: string;
  buttonText: string;
  /**
   * Where on the site this form sits (e.g. "closing-cta", "blog-post"). Sent
   * as the `placement` prop on the "Signup Form Viewed" Plausible event so the
   * goal can be broken down by location.
   */
  placement?: string;
  /** Element id; the homepage puts #signup on its section instead. */
  id?: string;
}

const { placeholder, buttonText, placement = "unknown", id = "signup" } = Astro.props;
---

<!-- Plain HTML post to Kit; the field name `email_address` is what Kit expects.
     Kit redirects to /confirmation after submit and to /thanks after the
     subscriber confirms (both set in the form's settings).
     `data-signup-form` + `data-placement` are read by scripts/signup-view.ts. -->
<form
  id={id}
  action={SIGNUP_FORM_ACTION}
  method={SIGNUP_FORM_METHOD}
  class="w-full"
  data-signup-form
  data-placement={placement}
>
  <label class="sr-only" for="signup-email">Email address</label>
  <div class="signup-shell flex w-full rounded-full bg-surface p-1">
    <input
      id="signup-email"
      type="email"
      name="email_address"
      autocomplete="email"
      required
      placeholder={placeholder}
      class="min-w-0 flex-1 bg-transparent px-5 text-base text-foreground placeholder:text-muted-foreground focus:outline-none"
    />
    <button
      type="submit"
      class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-transparent bg-accent-strong px-5 font-body text-[0.95rem] font-bold text-accent-foreground transition duration-200 ease-out hover:bg-accent-hover active:opacity-75 sm:px-6"
    >
      {buttonText}
    </button>
  </div>
</form>

<script>
  import "../../scripts/signup-view";
</script>

<style>
  /* The field's own colours, which a host section can override (the closing
     CTA's field is white in both themes). */
  .signup-shell {
    --field-bg: var(--surface);
    --field-fg: var(--foreground);
  }

  /* Browser autofill paints its own box (pale blue in light, slate in dark)
     and its own text colour over the field. Keep ours: an inset shadow covers
     the autofill background, and the long transition stops it fading back. */
  .signup-shell input:-webkit-autofill {
    -webkit-text-fill-color: var(--field-fg);
    caret-color: var(--field-fg);
    box-shadow: 0 0 0 100vmax var(--field-bg) inset;
    transition: background-color 9999s ease-out 0s;
  }

  /* Phones: the combined pill gets too tight, so the field and the button
     become two full-width controls, the way the app stacks a form field over
     its primary button. Placeholder stays left-aligned like any input. */
  @media (max-width: 40rem) {
    .signup-shell {
      flex-direction: column;
      gap: 0.6rem;
      padding: 0;
      background: transparent;
    }

    /* A visible edge, because the form also sits inside white cards
       (Plus, blog posts) where a white field would vanish. */
    .signup-shell input {
      min-height: 3.5rem;
      border-radius: 999px;
      background: var(--surface);
      border: 1.5px solid color-mix(in oklab, var(--foreground) 22%, transparent);
      padding-inline: 1.5rem;
    }

    .signup-shell button {
      width: 100%;
      height: 3.5rem;
      font-size: 1rem;
    }
  }
</style>
