---
import { SIGNUP_FORM_ACTION, SIGNUP_FORM_METHOD } from "../../consts";

interface Props {
  placeholder: string;
  buttonText: string;
  /**
   * Where on the site this form sits (e.g. "closing-cta", "blog-post"). Sent
   * as the `placement` prop on the "Signup Form Viewed" Plausible event so the
   * goal can be broken down by location.
   */
  placement?: string;
}

const { placeholder, buttonText, placement = "unknown" } = Astro.props;
---

<!-- Plain HTML post to Kit; the field name `email_address` is what Kit expects.
     Kit redirects to /confirmation after submit and to /thanks after the
     subscriber confirms (both set in the form's settings).
     `data-signup-form` + `data-placement` are read by scripts/signup-view.ts. -->
<form
  id="signup"
  action={SIGNUP_FORM_ACTION}
  method={SIGNUP_FORM_METHOD}
  class="w-full"
  data-signup-form
  data-placement={placement}
>
  <label class="sr-only" for="signup-email">Email address</label>
  <div class="signup-shell flex w-full rounded-full bg-surface p-1">
    <input
      id="signup-email"
      type="email"
      name="email_address"
      autocomplete="email"
      required
      placeholder={placeholder}
      class="min-w-0 flex-1 bg-transparent px-5 text-base text-foreground placeholder:text-muted-foreground focus:outline-none"
    />
    <button
      type="submit"
      class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-transparent bg-accent-strong px-5 font-body text-[0.85rem] font-bold text-accent-foreground transition duration-200 ease-out hover:bg-accent-strong/92 sm:px-6"
    >
      {buttonText}
    </button>
  </div>
</form>

<script>
  import "../../scripts/signup-view";
</script>

<style>
  /* Very narrow viewports: pill stacks so the input keeps a usable width
     instead of crushing its placeholder against the button */
  @media (max-width: 26rem) {
    .signup-shell {
      flex-direction: column;
      gap: 0.4rem;
      border-radius: 1.4rem;
      padding: 0.4rem;
    }

    .signup-shell input {
      min-height: 2.75rem;
      text-align: center;
    }

    .signup-shell button {
      width: 100%;
    }
  }
</style>
