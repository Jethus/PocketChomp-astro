---
interface Props {
  placeholder: string;
  buttonText: string;
}

const { placeholder, buttonText } = Astro.props;
---

<form id="signup" action="/contact" method="get" class="w-full">
  <label class="sr-only" for="signup-email">Email address</label>
  <input type="hidden" name="source" value="pocketchomp-beta" />
  <div class="signup-shell flex w-full rounded-full border border-accent bg-surface p-1 shadow-[var(--shadow-elevated)]">
    <input
      id="signup-email"
      type="email"
      name="email"
      placeholder={placeholder}
      class="min-w-0 flex-1 bg-transparent px-5 text-base text-foreground placeholder:text-muted-foreground focus:outline-none"
    />
    <button
      type="submit"
      class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-transparent bg-accent-strong px-5 font-body text-[0.85rem] font-bold text-white transition duration-200 ease-out hover:bg-accent-strong/92 sm:px-6"
    >
      {buttonText}
    </button>
  </div>
</form>

<style>
  /* Very narrow viewports: pill stacks so the input keeps a usable width
     instead of crushing its placeholder against the button */
  @media (max-width: 26rem) {
    .signup-shell {
      flex-direction: column;
      gap: 0.4rem;
      border-radius: 1.4rem;
      padding: 0.4rem;
    }

    .signup-shell input {
      min-height: 2.75rem;
      text-align: center;
    }

    .signup-shell button {
      width: 100%;
    }
  }
</style>
