---
/**
 * Pillar marks.
 *
 * The `tag` and `shield` paths are Lucide's `tag` and `shield-check`
 * (https://lucide.dev, ISC licensed, Copyright (c) 2020 Lucide Contributors),
 * inlined rather than pulled in as a dependency so the build stays static.
 * `maple` is the eleven-point heraldic leaf from the Canadian flag, drawn in
 * the same 24x24 box but filled rather than stroked, because at this size a
 * stroked outline closes its own notches.
 */
interface Props {
  name: "maple" | "tag" | "shield";
  class?: string;
}

const { name, class: className = "" } = Astro.props as Props;
---

<svg
  class:list={["pillar-icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "maple" && (
      /* Filled, not stroked: at 34px the outline's notches close up and the
         leaf turns into a blob. The silhouette stays legible. */
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2.2a.35.35 0 0 0-.32.2l-1.6 3.35a.35.35 0 0 1-.5.14L7.9 4.74a.35.35 0 0 0-.52.37l.56 2.9a.35.35 0 0 1-.46.4l-1.62-.6a.35.35 0 0 0-.45.2l-.5 1.35a.35.35 0 0 1-.42.21l-2.3-.6a.35.35 0 0 0-.4.48l1.18 2.6a.35.35 0 0 1-.13.43l-.75.5a.35.35 0 0 0-.4.55l4.3 3.6a.35.35 0 0 1 .11.37l-.42 1.5a.35.35 0 0 0 .38.44l3.9-.5a.35.35 0 0 1 .39.38l-.28 3.28a.35.35 0 0 0 .35.38h1.9a.35.35 0 0 0 .35-.38l-.28-3.28a.35.35 0 0 1 .39-.38l3.9.5a.35.35 0 0 0 .38-.44l-.42-1.5a.35.35 0 0 1 .11-.37l4.3-3.6a.35.35 0 0 0-.04-.55l-.75-.5a.35.35 0 0 1-.13-.43l1.18-2.6a.35.35 0 0 0-.4-.48l-2.3.6a.35.35 0 0 1-.42-.21l-.5-1.35a.35.35 0 0 0-.45-.2l-1.62.6a.35.35 0 0 1-.46-.4l.56-2.9a.35.35 0 0 0-.52-.37l-1.68 1.15a.35.35 0 0 1-.5-.14l-1.6-3.35A.35.35 0 0 0 12 2.2Z"
      />
    )
  }
  {
    name === "tag" && (
      /* Filled body with the eyelet knocked out via fill-rule, so the hole
         shows the disc behind it rather than a painted circle. */
      <path
        fill="currentColor"
        stroke="none"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M2 12V2h10l9.44 9.44a2 2 0 0 1 0 2.82l-7.18 7.18a2 2 0 0 1-2.82 0L2 12Zm5.5-3.2a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Z"
      />
    )
  }
  {
    name === "shield" && (
      /* Filled body with the check knocked out of it. */
      <path
        fill="currentColor"
        stroke="none"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm3.78-11.72a.9.9 0 0 0-1.28-1.26L11 12.52l-1.36-1.36a.9.9 0 0 0-1.28 1.27l2 2a.9.9 0 0 0 1.28 0l4.14-4.15Z"
      />
    )
  }
</svg>

<style>
  .pillar-icon {
    width: 1.55rem;
    height: 1.55rem;
    flex: none;
  }
</style>
