---
/**
 * Pillar marks.
 *
 * The `tag` and `shield` paths are Lucide's `tag` and `shield-check`
 * (https://lucide.dev, ISC licensed, Copyright (c) 2020 Lucide Contributors),
 * inlined rather than pulled in as a dependency so the build stays static.
 * `maple` is the leaf from the Flag of Canada, the flag's own vector path,
 * filled rather than stroked, because at this size an outline closes its notches.
 */
interface Props {
  name: "maple" | "tag" | "shield";
  class?: string;
}

const { name, class: className = "" } = Astro.props as Props;
---

<svg
  class:list={["pillar-icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "maple" && (
      /* The maple leaf from the Flag of Canada, using the flag's standard
         vector path (public domain, as on Wikimedia Commons' Flag of Canada
         SVG). Drawn in its own viewBox, square around the leaf with the same
         breathing room as the other 24px icons, so it sits level with them. */
      <svg x="0" y="0" width="24" height="24" viewBox="2500 118 4594 4594">
        <path
          fill="currentColor"
          stroke="none"
          d="m4890 4430-45-863a95 95 0 0 1 111-98l859 151-116-320a65 65 0 0 1 20-73l941-762-212-99a65 65 0 0 1-34-79l186-572-542 115a65 65 0 0 1-73-38l-105-247-423 454a65 65 0 0 1-111-57l204-1052-327 189a65 65 0 0 1-91-27l-332-652-332 652a65 65 0 0 1-91 27l-327-189 204 1052a65 65 0 0 1-111 57l-423-454-105 247a65 65 0 0 1-73 38l-542-115 186 572a65 65 0 0 1-34 79l-212 99 941 762a65 65 0 0 1 20 73l-116 320 859-151a95 95 0 0 1 111 98l-45 863z"
        />
      </svg>
    )
  }
  {
    name === "tag" && (
      /* Filled body with the eyelet knocked out via fill-rule, so the hole
         shows the disc behind it rather than a painted circle. */
      <path
        fill="currentColor"
        stroke="none"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M2 12V2h10l9.44 9.44a2 2 0 0 1 0 2.82l-7.18 7.18a2 2 0 0 1-2.82 0L2 12Zm5.5-3.2a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Z"
      />
    )
  }
  {
    name === "shield" && (
      /* Filled body with the check knocked out of it. */
      <path
        fill="currentColor"
        stroke="none"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm3.78-11.72a.9.9 0 0 0-1.28-1.26L11 12.52l-1.36-1.36a.9.9 0 0 0-1.28 1.27l2 2a.9.9 0 0 0 1.28 0l4.14-4.15Z"
      />
    )
  }
</svg>

<style>
  .pillar-icon {
    width: 1.55rem;
    height: 1.55rem;
    flex: none;
  }
</style>
