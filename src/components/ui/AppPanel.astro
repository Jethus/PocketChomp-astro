---
/**
 * "Straight from the app" panel: a dark card around one cropped piece of
 * real UI (the label is for screen readers). Both feature cards on the homepage use it so
 * the app extracts read as one family instead of one floating phone and
 * one floating card.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props as Props;
---

<div class:list={["app-panel", className]} data-reveal>
  <p class="sr-only">{label}</p>
  <div class="app-panel__shot">
    <slot />
  </div>
</div>

<style>
  .app-panel {
    overflow: hidden;
    border-radius: 1.6rem;
    padding: 1rem;
    background: oklch(0.14 0.006 145);
    color: white;
    box-shadow: var(--shadow-elevated);
  }

  .app-panel__shot {
    overflow: hidden;
    border-radius: 1rem;
  }

  .app-panel__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
