---
import { getEntry } from "astro:content";
import PlayBadge from "./PlayBadge.astro";
import SignupForm from "./SignupForm.astro";

/**
 * The app's two asks in one block: install from Google Play, or join the
 * email list. Copy comes from the closing CTA (signup-cta.md) so every page
 * says the same thing. Sits inside each page's own .cta-panel.
 */
interface Props {
  /** Passed to SignupForm for the "Signup Form Viewed" Plausible event. */
  placement: string;
}

const { placement } = Astro.props;

const ctaEntry = await getEntry("landingSignupCta", "signup-cta");

if (!ctaEntry) {
  throw new Error("Could not find PocketChomp signup CTA content");
}

const { emailLead, inputPlaceholder, buttonText } = ctaEntry.data;
---

<div class="app-cta">
  <PlayBadge />
  <p class="app-cta__lead">{emailLead}</p>
  <SignupForm placeholder={inputPlaceholder} buttonText={buttonText} placement={placement} />
</div>

<style>
  .app-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .app-cta__lead {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    color: var(--muted-foreground);
  }

  @media (max-width: 40rem) {
    .app-cta {
      align-items: stretch;
    }
  }
</style>
