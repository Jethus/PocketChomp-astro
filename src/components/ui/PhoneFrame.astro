---
import { getImage } from "astro:assets";
import androidFrameDark from "../../assets/png/android-frame-dark.png";
import androidFrameLight from "../../assets/png/android-frame-light.png";

interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Screen image URL. Ignored when a screen element is passed as the default slot. */
  src?: string;
  alt?: string;
  loading?: "eager" | "lazy";
}

const { src, alt = "", class: className = "", loading = "lazy", ...rest } = Astro.props as Props;
const hasSlottedScreen = Astro.slots.has("default");

const [frameLight, frameDark] = await Promise.all([
  getImage({ src: androidFrameLight, width: 640, format: "webp" }),
  getImage({ src: androidFrameDark, width: 640, format: "webp" }),
]);
---

<div {...rest} class:list={["phone-frame relative", className]}>
  <img src={frameLight.src} alt="" class="phone-frame__spacer phone-frame__spacer--light" aria-hidden="true" loading={loading} />
  <img src={frameDark.src} alt="" class="phone-frame__spacer phone-frame__spacer--dark" aria-hidden="true" loading={loading} />
  {hasSlottedScreen ? (
    <div class="phone-frame__screen phone-frame__screen--slot">
      <slot />
    </div>
  ) : (
    <img src={src} alt={alt} class="phone-frame__screen" loading={loading} />
  )}
  <img src={frameLight.src} alt="" class="phone-frame__top phone-frame__top--light" aria-hidden="true" loading={loading} />
  <img src={frameDark.src} alt="" class="phone-frame__top phone-frame__top--dark" aria-hidden="true" loading={loading} />
</div>

<style>
  /* In-flow spacer frame — invisible, just sets container height */
  .phone-frame__spacer {
    display: block;
    width: 100%;
    height: auto;
    visibility: hidden;
  }

  /* Light mode spacer: dark frame sets height, light frame hidden */
  .phone-frame__spacer--light {
    display: none;
  }

  /* These insets are tuned by eye against the frame art and are correct as they
     stand — an attempt to derive them from the PNG's alpha channel produced an
     overflowing screen, because the frame is opaque at the bezel and
     transparent BOTH in the screen window and outside its rounded corners, so a
     naive scan reads the two as one region.

     The real residual mismatch is the source captures: they are 1440x3120
     (1:2.167) while the window is roughly 1:2.13, so `cover` trims a little
     from the bottom. Re-capturing at the window's ratio would make the fit
     exact; nudging these percentages cannot fix a ratio difference. */
  .phone-frame__screen {
    position: absolute;
    inset: 3.4% 5.7% 3.3% 5.7%;
    width: 88.6%;
    height: 93.3%;
    border-radius: 2.4rem;
    object-fit: cover;
    object-position: top;
  }

  /* Slotted screen (e.g. <Image>) fills the same window as the plain img */
  .phone-frame__screen--slot {
    overflow: hidden;
  }

  .phone-frame__screen--slot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Visible frame rendered on top of screen */
  .phone-frame__top {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  /* Light mode: show dark frame on top */
  .phone-frame__top--light {
    display: none;
  }

  /* Dark mode: show light (silver) frame on top, hide dark overlay */
  :global(html[data-theme="dark"]) .phone-frame__top--light {
    display: block;
  }

  :global(html[data-theme="dark"]) .phone-frame__top--dark {
    display: none;
  }

  /* Spacer: dark mode uses light frame for height reference */
  :global(html[data-theme="dark"]) .phone-frame__spacer--dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .phone-frame__spacer--light {
    display: block;
  }
</style>
