---
// The screen images are "plates" built by scripts/build-screens.mjs: the
// native 1344x2992 capture already composited into the Pixel 8 Pro emulator
// skin at its 1:1 window, on a transparent canvas the size of the skin.
// There is no separate frame overlay to line up any more; this wrapper only
// sizes the image and keeps the rail's slot API.
interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Plate image URL. Ignored when a plate element is passed as the default slot. */
  src?: string;
  alt?: string;
  loading?: "eager" | "lazy";
  /** Intrinsic size of the plate so the browser reserves space before it loads. */
  width?: number;
  height?: number;
}

const { src, alt = "", class: className = "", loading = "lazy", width, height, ...rest } = Astro.props as Props;
const hasSlottedScreen = Astro.slots.has("default");
---

<div {...rest} class:list={["phone-frame", className]}>
  {hasSlottedScreen ? (
    <slot />
  ) : (
    <img src={src} alt={alt} class="phone-frame__plate" loading={loading} width={width} height={height} />
  )}
</div>

<style>
  .phone-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>
