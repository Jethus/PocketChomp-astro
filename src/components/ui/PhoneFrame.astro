---
import androidFrameDark from "../../assets/png/android-frame-dark.png";
import androidFrameLight from "../../assets/png/android-frame-light.png";

interface Props extends astroHTML.JSX.HTMLAttributes {
  src: string;
  alt: string;
}

const { src, alt, class: className = "", ...rest } = Astro.props as Props;
---

<div {...rest} class:list={["phone-frame relative", className]}>
  <img src={androidFrameLight.src} alt="" class="phone-frame__spacer phone-frame__spacer--light" aria-hidden="true" />
  <img src={androidFrameDark.src} alt="" class="phone-frame__spacer phone-frame__spacer--dark" aria-hidden="true" />
  <img src={src} alt={alt} class="phone-frame__screen" />
  <img src={androidFrameLight.src} alt="" class="phone-frame__top phone-frame__top--light" aria-hidden="true" />
  <img src={androidFrameDark.src} alt="" class="phone-frame__top phone-frame__top--dark" aria-hidden="true" />
</div>

<style>
  /* In-flow spacer frame — invisible, just sets container height */
  .phone-frame__spacer {
    display: block;
    width: 100%;
    height: auto;
    visibility: hidden;
  }

  /* Light mode spacer: dark frame sets height, light frame hidden */
  .phone-frame__spacer--light {
    display: none;
  }

  .phone-frame__screen {
    position: absolute;
    inset: 3.4% 5.7% 3.3% 5.7%;
    width: 88.6%;
    height: 93.3%;
    border-radius: 2.4rem;
    object-fit: cover;
    object-position: top;
  }

  /* Visible frame rendered on top of screen */
  .phone-frame__top {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  /* Light mode: show dark frame on top */
  .phone-frame__top--light {
    display: none;
  }

  /* Dark mode: show light (silver) frame on top, hide dark overlay */
  :global(html[data-theme="dark"]) .phone-frame__top--light {
    display: block;
  }

  :global(html[data-theme="dark"]) .phone-frame__top--dark {
    display: none;
  }

  /* Spacer: dark mode uses light frame for height reference */
  :global(html[data-theme="dark"]) .phone-frame__spacer--dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .phone-frame__spacer--light {
    display: block;
  }
</style>
