---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import PhoneFrame from "./ui/PhoneFrame.astro";

const railEntry = await getEntry("landingScreenRail", "screen-rail");

if (!railEntry) {
  throw new Error("Could not find PocketChomp screen-rail content");
}

const { eyebrow, headline, description, screens } = railEntry.data;

// The track is rendered twice so the marquee can loop seamlessly: the
// animation slides exactly one copy's width, then restarts on the identical
// second copy. Only the first copy is exposed to assistive tech.
const copies = [
  { key: "a", hidden: false },
  { key: "b", hidden: true },
];
---

<section id="screens" class="border-b border-border">
  <SectionShell innerClass="max-w-[90rem]" data-reveal-root>
    <div class="max-w-2xl">
      <p class="font-heading text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
        {eyebrow}
      </p>
      <h2 class="fs-xl mt-3 leading-[1.05] text-foreground">{headline}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {description}
      </p>
    </div>

  </SectionShell>

  <div class="marquee pb-10 sm:pb-12 lg:pb-14" data-marquee>
    <div class="marquee__viewport">
      <div class="marquee__track">
        {
          copies.map((copy) => (
            <ul class="marquee__group" role="list" aria-hidden={copy.hidden} aria-label={copy.hidden ? undefined : "PocketChomp app screens"}>
              {screens.map((screen) => (
                <li class="marquee__item">
                  <figure class="marquee__card">
                    <div class="marquee__shot">
                      <PhoneFrame class="marquee__phone">
                        <Image
                          src={screen.image}
                          alt={copy.hidden ? "" : screen.alt}
                          width={480}
                          widths={[240, 360, 480]}
                          quality={82}
                          sizes="(max-width: 40rem) 58vw, 15rem"
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                      </PhoneFrame>
                      {screen.tier === "plus" && <span class="marquee__badge">PocketChomp+</span>}
                    </div>
                  </figure>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-bleed viewport. The track is wider than the screen on purpose: cards
     run off both edges and fade out, so the section reads as a moving strip
     rather than a boxed carousel. */
  .marquee__viewport {
    overflow: hidden;
    /* Bottom padding covers the offset cards' extra 1.75rem plus shadow. */
    padding-block: 1.5rem 3.5rem;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 6rem,
      black calc(100% - 6rem),
      transparent
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 70s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Off-screen the rail should cost nothing. The compositor keeps ticking a
     running animation even when it is scrolled out of view, so the section
     drives the animation only while it actually intersects the viewport. */
  :global(html.js-marquee) .marquee:not([data-visible]) .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    flex: none;
    /* flex-start so the even-card margin offset reads as a vertical stagger
       rather than stretching those cards taller than their neighbours. */
    align-items: flex-start;
    gap: 1.5rem;
    padding-inline-end: 1.5rem;
    list-style: none;
    margin: 0;
    padding-block: 0;
    padding-inline-start: 0;
  }

  /* Layout containment only. Paint containment clipped the phones' drop
     shadows to the item box. */
  .marquee__item {
    flex: none;
    width: min(58vw, 15rem);
    contain: layout;
  }

  /* Alternate cards ride slightly lower so the strip has a rhythm instead of
     a flat row of identical phones. */
  .marquee__item:nth-child(even) {
    margin-block-start: 1.75rem;
  }

  .marquee__card {
    margin: 0;
  }

  .marquee__shot {
    position: relative;
  }

  /* A drop-shadow filter here re-rasterizes the blurred alpha of every phone
     on every animation frame, which is what made the rail stutter. The plate
     is an opaque rounded rectangle, so a plain box-shadow on the image is
     visually equivalent and composites for free. */
  .marquee__shot :global(img) {
    border-radius: 1.6rem;
    box-shadow: 0 22px 30px rgb(0 0 0 / 0.22);
  }

  .marquee__phone {
    width: 100%;
  }

  .marquee__badge {
    position: absolute;
    top: 0.9rem;
    right: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: var(--shadow-elevated);
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Reduced motion: no auto-scroll. The strip becomes an ordinary horizontal
     scroller and the duplicate copy is dropped so nothing repeats. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      mask-image: none;
      padding-inline: 1.5rem;
    }

    .marquee__viewport::-webkit-scrollbar {
      display: none;
    }

    .marquee__track {
      animation: none;
    }

    .marquee__group[aria-hidden="true"] {
      display: none;
    }

    .marquee__item {
      scroll-snap-align: start;
    }

  }
</style>
