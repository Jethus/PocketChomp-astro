---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";
import PhoneFrame from "./ui/PhoneFrame.astro";

import type { ImageMetadata } from "astro";

// The home page's row reads screen-rail.md. Another page (/plus) passes its
// own copy and screens, and a section id so the two never share an anchor.
interface Props {
  id?: string;
  eyebrow?: string;
  headline?: string;
  description?: string;
  screens?: { image: ImageMetadata; alt: string; tier?: "free" | "plus" }[];
}

const props = Astro.props as Props;
let { id = "screens", eyebrow, headline, description, screens } = props;

if (!screens) {
  const railEntry = await getEntry("landingScreenRail", "screen-rail");
  if (!railEntry) {
    throw new Error("Could not find PocketChomp screen-rail content");
  }
  ({ eyebrow, headline, description, screens } = railEntry.data);
}

// Renditions stop at the plate's own 1469 px width, and the widest card asks
// for at most ~1,000 device pixels (21rem at 3x), so a phone is never drawn
// above its native resolution.
const widths = [320, 480, 640, 800, 960, 1200];
---

<section id={id} class="border-b border-border">
  <SectionShell innerClass="max-w-[90rem]" data-reveal-root>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        {eyebrow && (
          <p class="font-heading text-xs font-black uppercase tracking-[0.18em] text-muted-foreground">
            {eyebrow}
          </p>
        )}
        {headline && <h2 class="fs-xl mt-3 leading-[1.05] text-foreground">{headline}</h2>}
        {description && (
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            {description}
          </p>
        )}
      </div>

      <div class="rail__nav" data-rail-nav>
        <button type="button" class="rail__btn" data-rail-prev aria-label="Previous screens" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="rail__btn" data-rail-next aria-label="More screens">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
  </SectionShell>

  <div class="rail" data-rail>
    <ul class="rail__list" role="list" aria-label="PocketChomp app screens">
      {
        screens.map((screen) => (
          <li class="rail__item">
            <figure class="rail__card">
              <div class="rail__shot">
                <PhoneFrame>
                  <Image
                    src={screen.image}
                    alt={screen.alt}
                    widths={widths}
                    sizes="(max-width: 47.99rem) min(72vw, 21rem), 20rem"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </PhoneFrame>
                {screen.tier === "plus" && <span class="rail__badge">PocketChomp+</span>}
              </div>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Arrow buttons for mouse users: page the strip by roughly two cards and
  // disable each arrow at its end. Touch and trackpads scroll it natively.
  for (const rail of document.querySelectorAll<HTMLElement>("[data-rail]")) {
    const section = rail.closest("section");
    const prev = section?.querySelector<HTMLButtonElement>("[data-rail-prev]");
    const next = section?.querySelector<HTMLButtonElement>("[data-rail-next]");
    if (!prev || !next) continue;

    const step = () => {
      const card = rail.querySelector<HTMLElement>(".rail__item");
      return card ? card.offsetWidth * 2 : rail.clientWidth * 0.6;
    };
    const update = () => {
      prev.disabled = rail.scrollLeft <= 4;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    };

    prev.addEventListener("click", () => rail.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => rail.scrollBy({ left: step(), behavior: "smooth" }));
    rail.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    update();
  }
</script>

<style>
  /* A still, swipeable strip. It used to be an auto-scrolling marquee; phones
     stuttered tiling the moving track, so nothing here animates. The strip
     starts in line with the section text and runs off the right edge. */
  .rail {
    --rail-gutter: max(1rem, calc((100vw - 90rem) / 2 + 1.5rem));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--rail-gutter);
    scrollbar-width: none;
    padding-block: 2rem 4rem;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail__list {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    width: max-content;
    margin: 0;
    padding: 0 var(--rail-gutter);
    list-style: none;
  }

  .rail__item {
    flex: none;
    width: 20rem;
    scroll-snap-align: start;
  }

  /* A four-step wave instead of a flat row of identical phones. */
  .rail__item:nth-child(4n + 2) {
    margin-block-start: 3.5rem;
  }

  .rail__item:nth-child(4n + 3) {
    margin-block-start: 1.25rem;
  }

  .rail__item:nth-child(4n + 4) {
    margin-block-start: 4.75rem;
  }

  .rail__card {
    margin: 0;
  }

  .rail__shot {
    position: relative;
  }

  .rail__shot :global(img) {
    border-radius: 2rem;
    box-shadow: 0 24px 40px rgb(0 0 0 / 0.18);
  }

  .rail__badge {
    position: absolute;
    top: 1.1rem;
    right: 0.9rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: var(--shadow-elevated);
  }

  .rail__nav {
    display: flex;
    gap: 0.75rem;
  }

  .rail__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--foreground);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .rail__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .rail__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Touch screens swipe; the arrows are for mice. */
  @media (hover: none) {
    .rail__nav {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .rail__item {
      width: min(72vw, 21rem);
    }

    .rail__item:nth-child(4n + 2) {
      margin-block-start: 2.25rem;
    }

    .rail__item:nth-child(4n + 4) {
      margin-block-start: 3rem;
    }
  }
</style>
