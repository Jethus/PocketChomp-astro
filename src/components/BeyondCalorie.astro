---
import { getEntry } from "astro:content";
import SectionShell from "./ui/SectionShell.astro";

const beyondEntry = await getEntry("landingBeyondCalorie", "beyond-calorie");

if (!beyondEntry) {
  throw new Error("Could not find PocketChomp beyond-calorie content");
}

const { headline, description, nutrients, panelLabel, image, imageAlt } = beyondEntry.data;
---

<SectionShell
  class="pt-8"
  innerClass="overflow-hidden rounded-[2.5rem] bg-accent px-6 py-10 text-accent-foreground shadow-[var(--shadow-elevated-lg)] md:px-10 md:py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(18rem,1fr)] lg:items-center lg:gap-14"
  data-reveal-root
>
  <div>
    <h2 class="fs-xl max-w-[8ch] leading-[0.95]">
      {headline}
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-black/80">
      {description}
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        nutrients.map((nutrient) => (
          <li class="rounded-full border border-black/18 bg-black/6 px-5 py-3 font-heading text-base font-black uppercase tracking-wide">
            {nutrient}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="mt-10 overflow-hidden rounded-[1.6rem] bg-black/92 p-5 text-white shadow-[var(--shadow-elevated)] lg:mt-0"
    data-reveal
  >
    <p class="text-sm uppercase tracking-[0.22em] text-white/62">{panelLabel}</p>
    <img
      src={image.src}
      alt={imageAlt}
      width={image.width}
      height={image.height}
      class="mt-4 w-full rounded-[1rem]"
      loading="lazy"
    />
  </div>
</SectionShell>
