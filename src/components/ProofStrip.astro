---
import { getEntry } from "astro:content";

const entry = await getEntry("landingProofStrip", "proof-strip");

if (!entry) {
  throw new Error("Could not find PocketChomp proof strip content");
}

const { items } = entry.data;
---

<section aria-label="PocketChomp at a glance" data-reveal-root>
  <div class="proof-grid mx-auto w-full max-w-7xl px-6 py-10 md:py-14">
    {
      items.map((item, index) => (
        <div class="proof-item" data-reveal data-index={index}>
          <p class="proof-item__value">{item.value}</p>
          {item.label && <p class="proof-item__label">{item.label}</p>}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Big number over a short label, the stat treatment every app site in the
     category uses. Short values mean the number can be large without ever
     overflowing its column. */
  .proof-grid {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 40rem) {
    .proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .proof-item + .proof-item {
      border-left: 1px solid color-mix(in oklab, var(--foreground) 16%, transparent);
    }
  }

  .proof-item {
    text-align: center;
    min-width: 0;
    padding-inline: 1rem;
    container-type: inline-size;
  }

  .proof-item__value {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 900;
    /* Capped to the column too, so an eight-character number like
       "140,000+" never runs into the rule in the three-up layout. */
    font-size: min(clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem), 19cqi);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--foreground);
    white-space: nowrap;
  }

  .proof-item__label {
    margin: 0.6rem 0 0;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.15rem);
    font-weight: 500;
    color: var(--muted-foreground);
    text-wrap: balance;
  }

  /* Stagger in CSS — inline style attributes are blocked by the site CSP */
  .proof-item[data-index="1"] { --reveal-delay: 100ms; }
  .proof-item[data-index="2"] { --reveal-delay: 200ms; }
</style>
