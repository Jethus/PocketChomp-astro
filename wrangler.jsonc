{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketchomp",
  "compatibility_date": "2026-09-08",
  "main": "./worker/index.js",
  "routes": [
    { "pattern": "pocketchomp.com", "custom_domain": true },
    { "pattern": "www.pocketchomp.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  // Store and restaurant requests from /database (worker/foodRequests.js).
  // `npm run requests` shows the latest; migrations live in ./migrations.
  "d1_databases": [
    {
      "binding": "REQUESTS_DB",
      "database_name": "pocketchomp-requests",
      "database_id": "f0f98ec4-1f54-494a-bade-1cdbac341a2e"
    }
  ],
  // Per-IP limit on request submissions, counted in memory; no IP is stored.
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
